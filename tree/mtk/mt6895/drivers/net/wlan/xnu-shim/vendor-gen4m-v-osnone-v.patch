+/* Android V 版 chips/soc7_0/soc7_0.c:541 在 CFG_SUPPORT_QA_TOOL +
+ * CONFIG_WLAN_SERVICE==1 下定义 struct test_capability soc7_0_toolCapability，
+ * 而该类型与两个子结构只存在于 wlan_service/glue/osal/include/net_adaption.h
+ * （不在本编译链上）。以下三结构逐字段照搬，尺寸必须一致（soc7_0_toolCapability
+ * 是全局对象，ATe ops 会按 sizeof 回给 QA 工具）。 */
+struct test_capability_ph_cap {
+	/* header */
+	unsigned int tag;		/* GET_CAPABILITY_TAG_PHY */
+	unsigned int tag_len;	/* GET_CAPABILITY_TAG_PHY_LEN */
+
+	/* content: GET_CAPABILITY_TAG_PHY_LEN */
+
+	/* BIT0: 11 a/b/g, BIT1: 11n, BIT2: 11ac, BIT3: 11ax */
+	unsigned int protocol;
+
+	/* 1:1x1, 2:2x2, ... */
+	unsigned int max_ant_num;
+
+	/* BIT0: DBDC support */
+	unsigned int dbdc;
+
+	/* BIT0: TxLDPC, BTI1: RxLDPC, BIT2: TxSTBC, BIT3: RxSTBC */
+	unsigned int coding;
+
+	/* BIT0: 2.4G, BIT1: 5G, BIT2: 6G */
+	unsigned int channel_band;
+
+	/* BIT0: BW20, BIT1: BW40, BIT2: BW80 */
+	/* BIT3: BW160C, BIT4: BW80+80(BW160NC) */
+	/* BIT5: BW320 */
+	unsigned int max_bandwidth;
+
+	/* BIT0: Band0 2.4G, BIT1: Band0 5G, BIT2: Band0 6G */
+	/* BIT16: Band1 2.4G, BIT17: Band1 5G, BIT18: Band1 6G */
+	unsigned int channel_band_dbdc;
+
+	/* BIT0: Band2 2.4G, BIT1: Band2 5G, BIT2: Band2 6G */
+	/* BIT16: Band3 2.4G, BIT17: Band3 5G, BIT18: Band3 6G */
+	unsigned int channel_band_dbdc_ext;	/* CFG_SUPPORT_CONNAC3X */
+
+	/* BIT[7:0]: PHY index (bitwise) */
+	/* BIT[15:8]: Adie index (bitwise) */
+	unsigned int phy_adie_index; /* phy_adie_index CFG_SUPPORT_CONNAC3X */
+
+	/* BIT[7:0]: Band0 TX path num */
+	/* BIT[15:8]: Band0 RX path num */
+	/* BIT[23:16]: Band1 TX path num */
+	/* BIT[31:24]: Band1 RX path num */
+	unsigned int band_0_1_wf_path_num;
+
+	/* BIT[7:0]: Band2 TX path num */
+	/* BIT[15:8]: Band2 RX path num */
+	/* BIT[23:16]: Band3 TX path num */
+	/* BIT[31:24]: Band3 RX path num */
+	unsigned int band_2_3_wf_path_num;
+
+	/* BIT[7:0]: Band0 system bandwidth */
+	/* BIT[15:8]: Band1 system bandwidth */
+	/* BIT[23:16]: Band2 system bandwidth */
+	/* BIT[31:24]: Band3 system bandwidth */
+	unsigned int band_bandwidth;
+
+	unsigned int reserved[4];
+};
+
+
+struct test_capability_ext_cap {
+	/* header */
+	unsigned int tag;		/* GET_CAPABILITY_TAG_PHY_EXT */
+	unsigned int tag_len;	/* GET_CAPABILITY_TAG_PHY_EXT_LEN */
+
+	/* content: GET_CAPABILITY_TAG_PHY_EXT_LEN */
+
+	/* BIT0: AntSwap */
+	/* BIT1: HW TX support */
+	/* BIT2: Little core support */
+	/* BIT3: XTAL trim support */
+	/* BIT4: DBDC/MIMO switch support */
+	/* BIT5: eMLSR support */
+	/* BIT6: MLR+, ALR support */
+	/* BIT7: Bandwidth duplicated debug support */
+	/* BIT8: dRU support */
+
+	unsigned int feature1;
+	unsigned int reserved[15];
+};
+
+struct test_capability {
+	unsigned int version;
+	unsigned int tag_num;
+	struct test_capability_ph_cap ph_cap;
+	struct test_capability_ext_cap ext_cap;
+};
+
