@@ -2258,6 +2258,26 @@
  * Major ADAPTER structure
  * Major data structure for driver operation
  */
+/* Android V 版把 DFS 的入口表放进了 ADAPTER，而 enum 与结构只在
+ * os/linux/include/gl_os.h:1405/1412 定义。这条 include 链上 adapter.h 会
+ * 早于 os/none 的 gl_os.h 到达，所以定义搬到这里：wlan_def.h 里的
+ * struct RF_CHANNEL_INFO 在本文件前面已经可见。值与 os/linux 完全一致。 */
+#ifndef _XAGA_DFS_CTRL_SOURCE_DEFINED
+#define _XAGA_DFS_CTRL_SOURCE_DEFINED
+enum DFS_CHANNEL_CTRL_SOURCE {
+	DFS_CHANNEL_CTRL_SOURCE_STA,
+	DFS_CHANNEL_CTRL_SOURCE_SAP,
+	DFS_CHANNEL_CTRL_SOURCE_DBG,
+	DFS_CHANNEL_CTRL_SOURCE_NUM
+};
+#endif
+
+struct WLAN_DFS_CHANNEL_REQ_ENTRY {
+	enum DFS_CHANNEL_CTRL_SOURCE eSource;
+	u_int8_t fgValid;
+	struct RF_CHANNEL_INFO rRfChnlInfo;
+};
