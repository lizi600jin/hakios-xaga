# HakiOS fragment: the MediaTek MT6895 (Dimensity 8100 / 8000) -- what is true of the SoC, whatever phone it is in. Laid
# over common_defconfig, which is the Qualcomm phone's: every driver of that SoC is left out of the kernel here (they would
# read Qualcomm's addresses), and whatever MediaTek drivers of mtk/mt6895/drivers/ the phone can use are put in. They are
# `default n`, so no other configuration gets them by accident.
#
# Four cores, as mtkloader starts them: core 0 (an A55, where LK leaves the boot), then the A78s, then the other A55s (its
# core_order). The loader passes the rest itself: the root, the panel's size, the clock.
#
# What is NOT here yet, and why (this is the honest state of the port, not an oversight):
#   - UFS. The MT6895 has no eMMC at all: the phone's storage is a UFS 3.1 controller at 0x112b0000 and /dev/block is all
#     sdcNN. mtk/loader/msdc.h only speaks MSDC (eMMC), so the loader cannot read a system image off it, and the kernel's
#     HAKIOS_UFS expects UEFI's UFSDxe to still be resident and serving -- which on MediaTek there is no UEFI to be. Until
#     the loader grows a UFS host and the kernel driver can own the controller from reset, a first boot has no disk:
#     the root is the ramdisk the payload carries and nothing else.
#   - The GPU. The MT6895's Mali is a G610 (Valhall), so mtk/mt6768's MALI (a Bifrost G52, no firmware, four power
#     domains) does not fit; mtk/mt6895/drivers/gpu/hakios.mali.c is written for this one instead. The screen comes up
#     either way: mtkloader sets the framebuffer up and hands it over in boot_args, and without a GPU the user space
#     draws in software.
#   - Keys and the sensor hub. The MT6895's keypad is at 0x1c00e000 (mediatek,kp) and its PMIC is an MT6363 over SPMI at
#     0x1c804000; mt6768's MTK_KEYS reads 0x10010000 and its PMIC directly. Same for MTK_SCP, whose firmware and SRAM map
#     are the MT6768's. Both need a driver of their own, not a recompile.
#   - Wi-Fi. CONNSYS on the MT6895 is a different generation with its own firmware; connsys_step is calibrated against the
#     MT6768's. Left out.

CONFIG_SOC="mt6895"
CONFIG_CPUS=4
# Qualcomm's: the storage, the touch screen and buttons on the PMIC, the Adreno, the DSPs, the modem, Wi-Fi, the chip's
# identity and sensors, the battery, the clocks
# CONFIG_UFS is not set
# CONFIG_TOUCHSCREEN is not set
# CONFIG_GPU is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_BUTTONS is not set
# CONFIG_HAKIOS_UFS is not set
# CONFIG_HAKIOS_ADRENO is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BATTERY is not set
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_WIFI is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
# QEMU's
# CONFIG_HAKIOS_VIRTIO_INPUT is not set
# CONFIG_HAKIOS_VIRTIO_SOUND is not set
# CONFIG_HAKIOS_VIRTIO_NET is not set
# CONFIG_HAKIOS_VIRTIO_BLK is not set
# The MT6768's drivers: this SoC has none of the blocks they were written for (see the header). They stay in the tree as
# the reference they are; mt6895 gets its own as they are written.
# CONFIG_HAKIOS_MTK_EMMC is not set
# CONFIG_HAKIOS_MTK_KEYS is not set
# CONFIG_HAKIOS_MTK_SCP is not set
# CONFIG_HAKIOS_MALI is not set
# CONFIG_HAKIOS_MTK_CONNSYS is not set

# The MT6895's own (mtk/mt6895/drivers/): what this SoC has, written for it.
# The touch screen: a Novatek NT36672E on SPI2, the four pins driven by hand because this SoC's SPI2_A pin
# function number is not in any header here (xaga.config turns it on with touchscreen=3).
CONFIG_HAKIOS_NVT=y
# The volume keys through the keypad at 0x1c00e000 and the power key through the MT6363's TOPSTATUS over SPMI
# (xaga.config turns it on with buttons=2).
CONFIG_HAKIOS_MTK6895_KEYS=y

# The USB device port: the MTU3 controller at 0x11201000, its IPPC block at 0x11203e00 and the port 0
# USB2 phy at 0x11e40000 (xaga.config turns it on with usb=2). Nothing in this tree had a USB stack, so
# this driver was written against Linux drivers/usb/mtu3/ and the phone's own LK.
CONFIG_HAKIOS_MT6895_USB=y
# The GPU, a Mali-G610 MC6 (Valhall, so it runs firmware this driver loads into it). Not mtk/mt6768's MALI, which is
# written for a Bifrost G52 with no firmware, four power domains instead of twelve, and a different MMU. What it needs
# that no other driver on this SoC reads: the SPM at 0x1c001000, topckgen's two GPU muxes, MFGPLL at 0x13fa0000 and
# mfgcfg at 0x13fbf000 (xaga.config turns it on with mali=2).
CONFIG_HAKIOS_MALI610=y
