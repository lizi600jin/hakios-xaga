diff --git a/Makefile b/Makefile
index 686124d..90a507d 100644
--- a/Makefile
+++ b/Makefile
@@ -51,6 +51,10 @@ DEVICE ?= x6826b
 # a MediaTek device: its SoC's layer is in mtk/ (its device.conf says `soc mt...`), and so are its loader and runner
 DEVICE_SOC := $(shell awk '$$1 == "soc" { print $$2; exit }' devices/$(DEVICE)/device.conf 2>/dev/null)
 MTK := $(if $(wildcard mtk/$(DEVICE_SOC)/soc.conf),1,)
+# The one-run script: xnu-cycle.sh for a phone that can be handed a kernel out of RAM, and
+# mtk/tools/<device>-cycle.sh where it cannot (xaga's fastboot registers no `boot:` command, so every
+# run writes boot_a -- see mtk/README.md).
+CYCLE ?= $(if $(wildcard mtk/tools/$(DEVICE)-cycle.sh),mtk/tools/$(DEVICE)-cycle.sh,mtk/tools/xnu-cycle.sh)
 RAMDISK ?= userland/root.apfs
 SYSTEM_IMAGE ?= userland/system.apfs
 JOBS ?= 8
@@ -158,7 +162,7 @@ phone:
 ifneq ($(MTK),)
 	$(MAKE) payload
 	mkdir -p logs
-	XNU_SECS=$(SECS) XNU_ARGS="$(ARGS)" XNU_LOG_OUT=$${XNU_LOG_OUT:-logs/xnu-$(DEVICE).log} mtk/tools/xnu-cycle.sh
+	XNU_SECS=$(SECS) XNU_ARGS="$(ARGS)" XNU_LOG_OUT=$${XNU_LOG_OUT:-logs/xnu-$(DEVICE).log} $(CYCLE)
 else
 	XL_SB_DELAY=8 $(RUNNER_BASE) tools/modem-cycle.sh "$(ARGS)" $(SECS)
 endif
