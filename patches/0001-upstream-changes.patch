+5:  lsl     x7, x3, #61
+    lsr     x7, x7, #61             /* x7 = len & 7 */
+    cbz     x7, 3f
+4:  sub     x7, x7, #1
+    ldrb    w6, [x2, x7]
+    add     x8, x1, x7
+    sub     x8, x8, x2
+    strb    w6, [x8]
+    cbnz    x7, 4b
+    b       3f
+
+2:  /* forward */
+    lsr     x7, x3, #3
+    lsl     x7, x7, #3
+    cbz     x7, 9f
+    add     x7, x2, x7
+8:  ldr     x6, [x2], #8
+    str     x6, [x1], #8
+    cmp     x2, x7
+    b.lo    8b
+9:  lsl     x7, x3, #61
