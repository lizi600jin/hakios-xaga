diff --git a/mtk/loader/mtkmali.h b/mtk/loader/mtkmali.h
index 89085e9..8e59c3f 100644
--- a/mtk/loader/mtkmali.h
+++ b/mtk/loader/mtkmali.h
@@ -149,16 +149,28 @@ static const struct mali_domain mali_domains[4] = {
 
 /* ---- waiting, with a limit on it ---- */
 
-/* Until (register & mask) == want, for at most `ms`. 1 if it got there. */
+#ifndef MALI_MAX_POLLS
+#define MALI_MAX_POLLS       (1u << 22)
+#endif
+
+/*
+ * Until (register & mask) == want, for at most `ms`. 1 if it got there.
+ *
+ * The `ms` bound is a bound only while the counter runs; where it does not, the same poll count
+ * as everywhere else in this loader is what ends the wait, so a GPU that never answers costs a
+ * short pause rather than the boot.
+ */
 static int mali_wait(uint64_t reg, uint32_t mask, uint32_t want, uint32_t ms)
 {
 	uint64_t end = dbg_ticks() + dbg_freq() / 1000 * ms;
 
+	uint32_t polls = MALI_MAX_POLLS;
+
 	do {
 		if ((rd32(reg) & mask) == want) {
 			return 1;
 		}
-	} while (dbg_ticks() < end);
+	} while (dbg_ticks() < end && --polls != 0);
 	return 0;
 }
 
