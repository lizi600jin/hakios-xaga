+/*
+ * Write the plane address of whichever OVL layer is scanning a panel-sized picture, so that the
+ * engine reads from `target` instead of wherever it was pointed. The block chosen is the same one
+ * the probe in start() looks for: src_con names the live layers, and the layer has to describe
+ * exactly this panel. Only the address register is touched -- con, size, offset and pitch are left
+ * as they are -- so the geometry the engine reports on the next fb_disp stays comparable.
+ */
+bool
+IOMobileFramebuffer::ovlPointAt(uint64_t target)
+{
+	const uint32_t geometry = 0x99c021c;      /* 2460 rows over 1080 columns, as OVL4 reads */
+	uint32_t lowest = 0;
+	int64_t delta;
+
+	/*
+	 * Find the plane that starts earliest; that is the picture's own base.
+	 *
+	 * The panel is described with two DSC slices (panel-l16-42-02-0a: DSC_SLICE_WIDTH 540, half of
+	 * 1080), and ovl6 l0 sits 0x870 bytes -- two thousand one hundred and sixty, five hundred and
+	 * forty pixels at four bytes each, one slice exactly -- above ovl4 l0. That distance is the
+	 * slice routing the engine was configured with, and it has to survive: two live planes reading
+	 * the same address is what put the frame out in bands, and moving only one of them is what
+	 * left the left half of the picture right and the right half wrong.
+	 */
+	for (size_t i = 0; i < sizeof(gOvlBlocks) / sizeof(gOvlBlocks[0]); i++) {
+		vm_offset_t window = ml_io_map((vm_offset_t) gOvlBlocks[i].base, PAGE_SIZE);
+		uint32_t src;
+
+		if (window == 0) {
+			continue;
+		}
+		src = ((volatile uint32_t *) window)[0x02c / 4];
+		for (unsigned layer = 0; layer < 4; layer++) {
+			uint32_t at = 0x030 + 0x20 * layer, addr;
+
+			if ((src & (1u << layer)) == 0) {
+				continue;
+			}
+			if (((volatile uint32_t *) window)[(at + 0x08) / 4] != geometry) {
+				continue;
+			}
+			addr = ((volatile uint32_t *) window)[(0x0f40 + 0x20 * layer) / 4];
+			if (addr < DISP_CARVE_LO || addr >= DISP_CARVE_HI) {
+				continue;
+			}
+			if (lowest == 0 || addr < lowest) {
+				lowest = addr;
+			}
+		}
+	}
+	if (lowest == 0) {
+		return false;
+	}
+	delta = (int64_t) (uint32_t) target - (int64_t) lowest;
+	if (delta == 0) {
+		return false;
+	}
+	/*
+	 * Slide every plane by the same amount, so the slice spacing inside the picture is unchanged
+	 * and only the picture's own origin moves.
+	 */
+	for (size_t i = 0; i < sizeof(gOvlBlocks) / sizeof(gOvlBlocks[0]); i++) {
+		vm_offset_t window = ml_io_map((vm_offset_t) gOvlBlocks[i].base, PAGE_SIZE);
+		uint32_t src;
+
+		if (window == 0) {
+			continue;
+		}
+		src = ((volatile uint32_t *) window)[0x02c / 4];
+		for (unsigned layer = 0; layer < 4; layer++) {
+			uint32_t at = 0x030 + 0x20 * layer, addr, moved_to;
+
+			if ((src & (1u << layer)) == 0) {
+				continue;
+			}
+			if (((volatile uint32_t *) window)[(at + 0x08) / 4] != geometry) {
+				continue;
+			}
+			addr = ((volatile uint32_t *) window)[(0x0f40 + 0x20 * layer) / 4];
+			if (addr < DISP_CARVE_LO || addr >= DISP_CARVE_HI) {
+				continue;
+			}
+			moved_to = (uint32_t) ((int64_t) addr + delta);
+			if (moved_to < DISP_CARVE_LO || moved_to >= DISP_CARVE_HI) {
+				continue;
+			}
+			((volatile uint32_t *) window)[(0x0f40 + 0x20 * layer) / 4] = moved_to;
+			IOLog("MiniIOMobileFramebuffer: %s l%u pointed at %#x, was %#x\n",
+			    gOvlBlocks[i].name, layer, moved_to, addr);
+		}
+	}
+	return true;
+}
