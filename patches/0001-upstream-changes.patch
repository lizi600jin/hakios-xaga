+		    ((volatile uint32_t *) window)[(rows[i].where & (PAGE_SIZE - 1)) / 4]);
+	}
+	IOLog("MiniIOMobileFramebuffer: fb_disp: panel %ux%u rowbytes %u, picture %ux%u crop %u fill %u\n",
+	    fPanelWidth, fPanelHeight, fRowBytes, fWidth, fHeight, fCropX, fFillWidth);
+}
