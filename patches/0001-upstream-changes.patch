--- a/mtk/loader/fbdiag_start.S
+++ b/mtk/loader/fbdiag_start.S
@@ -51,15 +51,72 @@ entry:
 /*
  * chain_stub(dtb, dst, src, len, entry): copy the Linux Image down over this program and enter
  * it as LK would have (x0 = dtb, x1-x3 = 0). C copies this stub out of the way first, since the
- * copy overwrites the code that does it. Position independent; len is a multiple of 8.
+ * copy overwrites the code that does it. Position independent, and the remainder is moved by
+ * bytes: see start.S for why the length here is not a multiple of eight.
  */
 .global chain_stub
 .global chain_stub_end
 chain_stub:
-1:  ldr     x6, [x2], #8
-    str     x6, [x1], #8
-    subs    x3, x3, #8
+    /*
+     * Copied with the direction chosen for the overlap, and with the short tail handled either
+     * way.  The length here is Android's Image (42201364 bytes on this board), which is not a
+     * multiple of eight, so a copy that only moves whole doublewords loses bytes: forward loses
+     * the last few, which is padding and harmless; backward loses the FIRST few, and the first
+     * bytes of an arm64 kernel Image are its entry branch.  That is the one that must not happen,
+     * so the leading remainder is copied byte by byte after the doublewords have moved.
+     *
+     * Nothing here may read or write at an address that is not eight-aligned unless it is a byte
+     * access: the loader runs with the MMU off, where every access is Device memory and an
+     * unaligned one faults.  That is also why the remainder is taken with shifts rather than by
+     * starting the doubleword walk at src+len-8.
+     */
+    cmp     x1, x2
+    b.ls    2f                      /* dst <= src: a forward copy is safe */
+    add     x6, x2, x3
+    cmp     x1, x6
+    b.hs    2f                      /* dst >= src + len: no overlap at all */
+
+    /* backward: the whole doublewords from the end, then the leading remainder bytes */
+    lsr     x7, x3, #3
+    lsl     x7, x7, #3              /* x7 = len & ~7 */
+    cbz     x7, 5f
+    add     x7, x2, x7              /* x7 walks down from src + whole */
+1:  sub     x7, x7, #8
+    ldr     x6, [x7]
+    add     x8, x1, x7
+    sub     x8, x8, x2              /* the same offset in the destination */
+    str     x6, [x8]
+    cmp     x7, x2
     b.hi    1b
+5:  lsl     x7, x3, #61
+    lsr     x7, x7, #61             /* x7 = len & 7 */
+    cbz     x7, 3f
+4:  sub     x7, x7, #1
+    ldrb    w6, [x2, x7]
+    add     x8, x1, x7
+    sub     x8, x8, x2
+    strb    w6, [x8]
+    cbnz    x7, 4b
+    b       3f
+
+2:  /* forward */
+    lsr     x7, x3, #3
+    lsl     x7, x7, #3
+    cbz     x7, 9f
+    add     x7, x2, x7
+8:  ldr     x6, [x2], #8
+    str     x6, [x1], #8
+    cmp     x2, x7
+    b.lo    8b
+9:  lsl     x7, x3, #61
+    lsr     x7, x7, #61
+    cbz     x7, 3f
+10: sub     x7, x7, #1
+    ldrb    w6, [x2, x7]
+    strb    w6, [x1, x7]
+    cbnz    x7, 10b
+
+3:
     dsb     sy
     ic      iallu
     dsb     sy
