+    lsl     x7, x7, #3              /* x7 = len & ~7 */
+    cbz     x7, 5f
+    add     x7, x2, x7              /* x7 walks down from src + whole */
+1:  sub     x7, x7, #8
+    ldr     x6, [x7]
+    add     x8, x1, x7
