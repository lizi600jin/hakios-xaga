+		/* keep the tail: that is where the reason is */
+		p += len - (uint64_t)XNU_LOGBOOK_MAX;
+		len = (uint64_t)XNU_LOGBOOK_MAX;
+	}
+	for (uint64_t i = 0; i < len; i++) {
+		sum += p[i];
+	}
+	h.magic = XNU_LOGBOOK_MAGIC;
+	h.version = 1;
+	h.len = len;
+	h.reason = reason;
+	h.code = code;
+	h.elr = elr;
+	h.far = far;
+	h.ticks = dbg_ticks();
