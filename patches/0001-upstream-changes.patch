@@ -0,0 +1,204 @@
+#!/usr/bin/env python3
+"""Generate the Novatek touch firmware blob that hakios.nvt.c programs into the controller.
+
+Why this is needed at all: the vendor driver does not trust the image in the controller's own
+flash. After probing it queues Boot_Update_Firmware, and 14 seconds later that calls
+nvt_update_firmware(), which rewrites ILM, DLM, the header block and both overlay sections into
+the controller's SRAM -- on every single boot. So the "bootloader reset" the vendor issues before
+reading the chip id is not a recovery step; the chip genuinely comes up without a usable image,
+and any host that wants touch has to hand it one.
+
+Measured on xaga with this driver: the chip answers its trim id (0e 00 00 72 66 03, which selects
+NT36675_memory_map and hw_crc 2), the event buffer at 0x22D00 reads back stable bytes that never
+checksum, the fw handshake at 0x22D51 answers neither 0xA0 nor 0x00, and the reset-state byte at
+0x22D60 stays 0x3A across fifty 10 ms polls after an eng reset and a software reset. 0x3A is
+below RESET_STATE_INIT 0xA0, i.e. the firmware never started.
+
+usage: mtk/tools/mknvtfw.py [-o OUTPUT] [BIN]
+       default BIN is the Tianma part from the vendor partition dump;
+       default OUTPUT is drivers/input/hakios.nvt_fw.h
+
+The partition table is emitted as constants rather than parsed at run time: it is 139264 bytes of
+firmware, its header never changes for a given part, and a parser that can be wrong is worse than
+four constant rows that were checked once by this script (see --table to print them).
+"""
+
+import argparse
+import os
+import struct
+import sys
+
+DEFAULT_BIN = os.path.join(
+    os.path.dirname(os.path.abspath(__file__)),
+    "..", "..", "..", "work-xaga", "dt-device_xiaomi_xaga-TWRP",
+    "recovery", "root", "vendor", "firmware",
+    "novatek_nt36672e_l16_fw02.bin")
+# Which image, and why this one: novatek_nt36672e_l16_fw02.bin.
+#
+# Three earlier guesses were wrong and the boot log settled it. On a normal Android boot,
+# nvt_ts_resume calls nvt_update_firmware, which reaches nvt_match_fw / nvt_get_panel_type and
+# prints
+#
+#   [21.254] nvt_get_panel_type 1240: match panle type, fw is [novatek_nt36672e_l16_fw02.bin]
+#   [21.254] update_firmware_request 321: filename is novatek_nt36672e_l16_fw02.bin
+#   [21.339] nvt_update_firmware 1180: Update firmware success! <83891 us>
+#   [21.339] nvt_get_fw_info 754: FW type is 0x01, fw_ver=22
+#
+# So Android does download an image -- fw_ver=22 is the version of the file it just wrote, not a
+# factory image living in the chip. fw01 (what cfg_0 in the device tree names for a Tianma panel)
+# boots its identity but never leaves reset state a1: no baseline, no interrupt edges. fw02 runs,
+# and the panel is the CSOT one: the lockdown info this board reports starts 0x53 0x42, which is
+# cfg_1's tp-vendor 0x53 and display-maker 0x42. fw02 also carries 17 partitions (ovly_sec_num 2)
+# against novatek_ts_fw.bin's 15, so the coordinate tables differ between the two -- which is why
+# a matching FWINFO identity never guaranteed the axis scale.
+# The header lives with the other kernel files, not with the SoC: drivers/map is what tells
+# xnu/apply.sh and xnu/sync-drivers.sh where a .h goes, and a drivers/*/conf can only name .c
+# files. drivers/input/hakios.focaltech_fw.h set that precedent for a firmware blob.
+DEFAULT_OUT = os.path.join(
+    os.path.dirname(os.path.abspath(__file__)),
+    "..", "..", "drivers", "input", "hakios.nvt_fw.h")
+
+ILM_DLM_NUM = 2
+
+
+def word(data, at):
+    return struct.unpack_from("<I", data, at)[0]
+
+
+def parse(data):
+    """Reproduce nvt_bin_header_parser(): returns the list of (name, sram, size, bin, crc).
+
+    Sizes are the raw `size` field. The vendor treats it as a last index rather than a count:
+    nvt_write_firmware() adds one before writing, while nvt_set_bld_hw_crc() hands the raw value
+    to the bootloader's LENGTH register. Both numbers are therefore kept apart here, and the
+    header says which is which.
+    """
+    end = word(data, 0)
+    pos = 0x30
+    info_sec_num = 0
+    while pos < end:
+        info_sec_num += 1
+        pos += 0x10
+    ovly_info = (data[0x28] & 0x10) >> 4
+    ovly_sec_num = (data[0x28] & 0x0F) if ovly_info else 0
+    partition = ILM_DLM_NUM + ovly_sec_num + info_sec_num
+
+    rows = []
+    for i in range(partition):
+        if i < ILM_DLM_NUM:
+            bin_addr = word(data, 0 + i * 12)
+            sram = word(data, 4 + i * 12)
+            size = word(data, 8 + i * 12)
+            crc = word(data, 0x18 + i * 4)
+            name = "ILM" if i == 0 else "DLM"
+        elif i < ILM_DLM_NUM + info_sec_num:
+            at = 0x30 + 0x10 * (i - ILM_DLM_NUM)
+            sram = word(data, at)
+            size = word(data, at + 4)
+            bin_addr = word(data, at + 8)
+            crc = word(data, at + 12)
+            name = "Header" if (bin_addr == 0 and size != 0) else "Info-%d" % (i - ILM_DLM_NUM)
+        else:
+            # overlay sections are described by the DLM's own payload
+            at = word(data, 12) + 0x10 * (i - ILM_DLM_NUM - info_sec_num)
+            sram = word(data, at)
+            size = word(data, at + 4)
+            bin_addr = word(data, at + 8)
+            crc = word(data, at + 12)
+            name = "Overlay-%d" % (i - ILM_DLM_NUM - info_sec_num)
+        if bin_addr + size > len(data):
+            raise SystemExit("partition %s runs past the end of the file" % name)
+        rows.append((name, sram, size, bin_addr, crc))
+    return rows
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("bin", nargs="?", default=DEFAULT_BIN)
+    ap.add_argument("-o", "--output", default=DEFAULT_OUT)
+    ap.add_argument("--table", action="store_true", help="print the partition table and stop")
+    args = ap.parse_args()
+
+    with open(args.bin, "rb") as f:
+        data = f.read()
+    rows = parse(data)
+
+    if args.table:
+        for name, sram, size, bin_addr, crc in rows:
+            print("%-10s sram %#08x  size %#07x (+1)  bin %#08x  crc %#010x%s"
+                  % (name, sram, size, bin_addr, crc, "" if size else "  skipped, size is zero"))
+        return 0
+
+    # The two partitions that nvt_set_bld_hw_crc() describes to the bootloader: ILM then DLM.
+    ilm = rows[0]
+    dlm = rows[1]
+
+    lines = []
+    w = lines.append
+    w("/* Generated by mtk/tools/mknvtfw.py from %s. Do not edit. */"
+      % os.path.basename(args.bin))
+    w("#ifndef _HAKIOS_NVT_FW_H")
+    w("#define _HAKIOS_NVT_FW_H")
+    w("")
+    w("/*")
+    w(" * The image the vendor driver programs into the controller on every boot, over SPI, into")
+    w(" * the controller's SRAM. It is not a flash upgrade: the chip comes up in its bootloader,")
+    w(" * and this is what it is given to run.")
+    w(" *")
+    w(" * The partition table is the one the firmware carries in its own header, resolved here so")
+    w(" * that the driver does not have to reproduce nvt_bin_header_parser(). `size` is the raw")
+    w(" * field: nvt_write_firmware() writes size + 1 bytes, while nvt_set_bld_hw_crc() gives the")
+    w(" * raw value to the bootloader's LENGTH register. The difference is the vendor's, and both")
+    w(" * numbers matter, so the driver adds the one where it writes and not where it describes.")
+    w(" *")
+    w(" * %-10s sram %#08x  bin %#08x  size %#x (+1 written)  crc %#010x" % (ilm[0], ilm[1], ilm[3], ilm[2], ilm[4]))
+    w(" * %-10s sram %#08x  bin %#08x  size %#x (+1 written)  crc %#010x" % (dlm[0], dlm[1], dlm[3], dlm[2], dlm[4]))
+    for name, sram, size, bin_addr, crc in rows[2:]:
+        if not size:
+            continue
+        w(" * %-10s sram %#08x  bin %#08x  size %#x (+1 written)  crc %#010x" % (name, sram, bin_addr, size, crc))
+    w(" */")
+    w("")
+    w("#define NVT_FW_LENGTH %d" % len(data))
+    w("")
+    w("/* One row per partition that carries data; the zero-sized ones are dropped. */")
+    w("struct nvt_fw_part {")
+    w("\tuint32_t sram;")
+    w("\tuint32_t bin;")
+    w("\tuint32_t size;")
+    w("\tuint32_t crc;")
+    w("};")
+    w("")
+    w("#define NVT_FW_PARTS %d" % len(rows))
+    w("static const struct nvt_fw_part nvt_fw_parts[NVT_FW_PARTS] = {")
+    for name, sram, size, bin_addr, crc in rows:
+        w("\t{ %#08xu, %#08xu, %#xu, %#010xu },%s/* %s */"
+          % (sram, bin_addr, size, crc, "" if size else " ", name))
+    w("};")
+    w("")
+    w("#define NVT_FW_ILM_SRAM  %#08xu" % ilm[1])
+    w("#define NVT_FW_ILM_SIZE  %#xu" % ilm[2])
+    w("#define NVT_FW_ILM_CRC   %#010xu" % ilm[4])
+    w("#define NVT_FW_DLM_SRAM  %#08xu" % dlm[1])
+    w("#define NVT_FW_DLM_SIZE  %#xu" % dlm[2])
+    w("#define NVT_FW_DLM_CRC   %#010xu" % dlm[4])
+    w("")
+    w("static const unsigned char nvt_fw[NVT_FW_LENGTH] = {")
+    for at in range(0, len(data), 16):
+        chunk = data[at:at + 16]
+        w("\t" + " ".join("0x%02x," % b for b in chunk))
+    w("};")
+    w("")
+    w("#endif /* _HAKIOS_NVT_FW_H */")
+    w("")
+
+    text = "\n".join(lines)
+    with open(args.output, "w") as f:
+        f.write(text)
+    print("mknvtfw: %s -> %s (%d bytes of firmware, %d partitions, %d lines)"
+          % (os.path.basename(args.bin), args.output, len(data), len(rows), text.count("\n")))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/mtk/tools/nvt-slots.py b/mtk/tools/nvt-slots.py
new file mode 100644
index 0000000..d785f0b
--- /dev/null
+++ b/mtk/tools/nvt-slots.py
@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+"""Pull the finger reports out of a logbook and show which bytes carry what.
+
+The driver prints, for every report it accepts, a line of the shape
+
+    nvt: slots 1:2/956,923 all 0a 3b 39 cb 10 01 ff ...
+
+The point of dumping all sixty five bytes is that the vendor formula
+    x = (p[1] << 4) | (p[3] >> 4)     y = (p[2] << 4) | (p[3] & 0x0f)
+gives a horizontal axis that mirrors sensibly and a vertical axis whose spread
+is a quarter of the panel's. One of the two has to be wrong, and the way to
+tell which is to look at every byte across a set of presses at known places
+rather than reading the same two offsets again.
+
+Usage: python3 mtk/tools/nvt-slots.py xaga-logbook.bin
+"""
+
+import re
+import struct
+import sys
+
+HEADER = 72
+LINE = re.compile(r"nvt: slots(.*?) all((?: [0-9a-f]{2})+)")
+
+
+def reports(path):
+    raw = open(path, "rb").read()
+    magic, version, length = struct.unpack("<IIQ", raw[:16])
+
+    if magic != 0x474f4c48:
+        sys.exit("%s: no logbook header (magic %#x)" % (path, magic))
+    body = raw[HEADER:HEADER + length].decode("utf-8", "replace")
+    found = []
+
+    for line in body.split("\n"):
+        match = LINE.search(line)
+
+        if match is None:
+            continue
+        slots = match.group(1).strip()
+        data = bytes(int(byte, 16) for byte in match.group(2).split())
+        found.append((slots, data))
+    return found
+
+
+def main():
+    if len(sys.argv) != 2:
+        sys.exit(__doc__)
+    found = reports(sys.argv[1])
+
+    print("%d reports" % len(found))
+
+    if not found:
+        return
+
+    width = len(found[0][1])
+    print("\nper byte across the reports (min..max, distinct):")
+    for at in range(width):
+        column = [data[at] for _, data in found]
+        print("  [%2d] %3d..%3d  %2d distinct   %s"
+              % (at, min(column), max(column), len(set(column)),
+                 " ".join("%02x" % value for value in column[:16])))
+
+    print("\nslots as the driver decoded them:")
+    for slots, _ in found:
+        print("  %s" % slots)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/mtk/tools/xaga-auto.sh b/mtk/tools/xaga-auto.sh
new file mode 100755
index 0000000..98c2a14
--- /dev/null
+++ b/mtk/tools/xaga-auto.sh
@@ -0,0 +1,126 @@
+#!/bin/sh
+# xaga-auto.sh -- flash one image, wait for Android to come back, pull the log, print the parts
+# that matter. Written to run while nobody is watching: every step has a timeout and the script
+# never sits waiting on a device that is not there.
+#
+#   sh mtk/tools/xaga-auto.sh IMAGE [LABEL]
+#
+# IMAGE is the boot image to flash. The loader returns to Android by itself after
+# XNU_RETURN_AFTER seconds (board.h), so no recovery step is needed unless the flash itself
+# fails.
+#
+# Why this exists: the phone loses USB debugging every time it runs the iOS side, and getting it
+# back needs a physical replug. So a run is: wait for fastboot, flash, wait for the loader to
+# hand back, pull, analyse. Doing that by hand wastes the window.
+
+set -e
+
+IMAGE=${1:?usage: xaga-auto.sh IMAGE [LABEL]}
+LABEL=${2:-run}
+SERIAL=${HAKIOS_SERIAL:-GAJZ4HIN99AQ69Y9}
+ROOT=$(cd "$(dirname "$0")/../.." && pwd)
+
+cd "$ROOT"
+
+say() {
+	printf '[auto %s] %s\n' "$(date +%H:%M:%S)" "$1"
+}
+
+fastboot_here() {
+	timeout 3 fastboot devices 2>/dev/null | grep -q fastboot
+}
+
+adb_here() {
+	timeout 3 adb devices 2>/dev/null | grep -q "$SERIAL"
+}
+
+# 1. Get into fastboot. If Android answers, ask it to reboot; otherwise just wait, because
+#    after a previous run it usually comes up on its own.
+say "waiting for fastboot"
+if ! fastboot_here; then
+	if adb_here; then
+		say "android is up, asking it for the bootloader"
+		timeout 10 adb -s "$SERIAL" reboot bootloader >/dev/null 2>&1 || true
+	fi
+	deadline=$(( $(date +%s) + 600 ))
+	while [ "$(date +%s)" -lt "$deadline" ]; do
+		if fastboot_here; then
+			break
+		fi
+		sleep 4
+	done
+fi
+if ! fastboot_here; then
+	say "no fastboot after ten minutes; giving up (the phone probably needs a replug)"
+	exit 1
+fi
+say "fastboot is here"
+
+# 2. Record what the host sees, so the USB question has a timestamped answer either way.
+dmesg -C 2>/dev/null || echo 'admin' | sudo -S -p '' dmesg -C 2>/dev/null || true
+
+# 3. Flash.
+say "flashing $IMAGE as $LABEL"
+timeout 120 fastboot -s "$SERIAL" flash boot_a "$IMAGE" 2>&1 | grep -E 'Sending|Writing|FAILED' || true
+timeout 20 fastboot -s "$SERIAL" reboot >/dev/null 2>&1 || true
+
+# 4. Wait for the loader to hand control back to Android.
+say "waiting for android"
+deadline=$(( $(date +%s) + 400 ))
+while [ "$(date +%s)" -lt "$deadline" ]; do
+	if adb_here; then
+		break
+	fi
+	sleep 5
+done
+
+if ! adb_here; then
+	say "android did not come back; host usb events follow"
+	(dmesg -T 2>/dev/null || echo 'admin' | sudo -S -p '' dmesg -T 2>/dev/null) | grep -iE 'usb|18d1|0e8d|2717' | tail -20 || true
+	say "the phone needs a replug; re-run this script after that"
+	exit 1
+fi
+say "android is up"
+
+# 5. Pull the logbook. The script it calls writes xaga-logbook.bin in the repo root, and it
+#    leaves a stale file in place when the pull fails, so remove it first.
+rm -f xaga-logbook.bin
+sh mtk/tools/xaga-pull-log.sh "$SERIAL" >/dev/null 2>&1 || true
+if [ ! -f xaga-logbook.bin ]; then
+	say "the logbook was not pulled"
+	exit 1
+fi
+say "logbook is $(wc -c < xaga-logbook.bin) bytes, written $(date -r xaga-logbook.bin +%H:%M:%S)"
+
+# 6. Print the lines this project keeps needing. The header is 72 bytes; 64 loses the sum and
+#    throws off every field after it.
+python3 - "$LABEL" <<'PY'
+import struct, sys
+
+label = sys.argv[1]
+raw = open('xaga-logbook.bin', 'rb').read()
+if len(raw) < 72:
+	print('logbook: too short')
+	raise SystemExit(1)
+magic, ver, length = struct.unpack('<IIQ', raw[:16])
+if magic != 0x474f4c48:
+	print('logbook: header magic is %#x, not HLOG' % magic)
+	raise SystemExit(1)
+
+hdr = struct.unpack('<IIQQQQQQQQ', raw[:72])
+reason, code, elr, far = hdr[3], hdr[4], hdr[5], hdr[6]
+print('logbook %s: %d bytes, reason %d code %#x elr %#x far %#x'
+      % (label, length, reason, code, elr, far))
+
+body = raw[72:72 + length].decode('utf-8', 'replace')
+lines = body.split('\n')
+print('logbook: %d lines' % len(lines))
+
+wanted = ('nvt:', 'usb:', 'fb_disp:', 'mt6895', 'hakios', 'MiniIOMobile',
+          'display', 'panic', 'Panic', 'check failed', 'checks,')
+for line in lines:
+	if any(word in line for word in wanted):
+		print(line[:220])
+PY
+
+say "done"
diff --git a/mtk/tools/xaga-carve.sh b/mtk/tools/xaga-carve.sh
new file mode 100755
index 0000000..28dcfc2
--- /dev/null
+++ b/mtk/tools/xaga-carve.sh
@@ -0,0 +1,167 @@
+#!/bin/bash
+#
+# Put a partition for the system image on the XAGA, once, without touching anything else.
+#
+#   HAKIOS_SERIAL=<serial> mtk/tools/xaga-carve.sh --gib 2.5          # work out and show the plan
+#   HAKIOS_SERIAL=<serial> mtk/tools/xaga-carve.sh --gib 2.5 --write  # and actually write it
+#
+# Why this is its own script and not part of xaga-cycle.sh: changing the GPT is the one thing
+# here that cannot be undone by flashing a boot image. Every other step in this port either
+# restarts into Android on its own or is fixed by `fastboot flash boot_a backup/boot_a_magisk.img`;
+# a broken partition table leaves the phone with no by-name links and no fastboot slot to flash.
+# So it reads, computes, and prints -- and needs --write before it puts anything on the disk.
+#
+# What it does, in order:
+#   1. Asks the disk how big it is, and how big its logical blocks are. The XAGA answers 4096,
+#      not 512: reading LBA 1 with bs=512 comes back all zeros, because LBA 1 is byte 4096.
+#      Getting this wrong is silent -- the numbers all parse, they just describe nothing.
+#   2. Reads the primary GPT (blocks 0..33) and the backup (the last 34 blocks) into backup/gpt/.
+#      Both dumps are made on the phone and pulled: piping `adb shell su -c dd` into a file
+#      corrupts bytes (a pty is not a pipe), which is how the first attempt produced 3235 nonzero
+#      bytes of noise instead of a partition table.
+#   3. Runs gpt-carve.py, which re-checks both copies' checksums, moves the boundary of userdata
+#      back by --gib and puts xnusys in the space. It writes <dump>.new beside each dump.
+#   4. Verifies the two .new images agree with each other and with the disk's size.
+#   5. With --write only: pushes them back with dd conv=notrunc and syncs. The printout is the
+#      exact commands, so they can be run by hand if this script is not what is wanted.
+#
+# After this, run mtk/tools/system-flash.sh to put userland/system.apfs into xnusys.
+set -eu
+
+ROOT=$(cd "$(dirname "$0")/../.." && pwd)
+S=${HAKIOS_SERIAL:?set HAKIOS_SERIAL to the serial adb devices shows}
+GIB=${XAGA_SYS_GIB:-2.5}
+NAME=${XAGA_SYS_PART:-xnusys}
+VICTIM=${XAGA_SYS_SHRINK:-userdata}
+WRITE=${XAGA_SYS_WRITE:-0}
+OUT=${XAGA_GPT_OUT:-$ROOT/backup/gpt}
+LUN=${XAGA_LUN:-/dev/block/sdc}          # the disk the GPT is on, not a partition of it
+
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --gib)    GIB=$2; shift 2 ;;
+        --name)   NAME=$2; shift 2 ;;
+        --shrink) VICTIM=$2; shift 2 ;;
+        --lun)    LUN=$2; shift 2 ;;
+        --write)  WRITE=1; shift ;;
+        -h|--help) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
+        *) echo "xaga-carve: unknown argument $1" >&2; exit 1 ;;
+    esac
+done
+
+say() { echo "xaga-carve: $*"; }
+die() { echo "xaga-carve: $*" >&2; exit 1; }
+
+command -v adb >/dev/null || die "no adb on PATH"
+adb -s "$S" get-state >/dev/null 2>&1 || die "no phone at $S (adb devices)"
+adb -s "$S" shell "su -c id" >/dev/null 2>&1 || die "no root on $S: this needs su"
+
+mkdir -p "$OUT"
+
+# ---- 1. the disk, and the size of a logical block ----
+TOTAL_BYTES=$(adb -s "$S" shell "su -c 'blockdev --getsize64 $LUN'" | tr -d '\r')
+case "$TOTAL_BYTES" in ''|*[!0-9]*) die "could not read the size of $LUN (got '$TOTAL_BYTES')" ;; esac
+say "disk: $TOTAL_BYTES bytes ($(python3 -c "print('%.2f' % ($TOTAL_BYTES / 2**30))") GiB)"
+
+# The header is at LBA 1, so its offset IS the block size. 4096 is tried first because that is
+# what this phone answers; 512 stays for a disk that turns out to be the ordinary kind.
+LBA=0
+for cand in 4096 512; do
+    if adb -s "$S" shell "su -c 'dd if=$LUN bs=$cand skip=1 count=1 2>/dev/null'" | head -c 8 | grep -q "EFI PART"; then
+        LBA=$cand; break
+    fi
+done
+[ "$LBA" != 0 ] || die "no GPT header at LBA 1 read as 512 or 4096 bytes: $LUN is not a GPT disk"
+TOTAL=$((TOTAL_BYTES / LBA))
+say "logical block $LBA bytes, $TOTAL blocks"
+
+# ---- 2. read both copies (on the phone, then pull: a pty would corrupt them) ----
+TAIL=34                                  # protective MBR + header + a 128-entry array
+SKIP=$((TOTAL - TAIL))
+adb -s "$S" shell "su -c 'dd if=$LUN of=/data/local/tmp/gpt-primary.bin bs=$LBA count=$TAIL 2>/dev/null'" >/dev/null
+adb -s "$S" shell "su -c 'dd if=$LUN of=/data/local/tmp/gpt-secondary.bin bs=$LBA skip=$SKIP count=$TAIL 2>/dev/null'" >/dev/null
+adb -s "$S" pull /data/local/tmp/gpt-primary.bin "$OUT/gpt-primary.bin" >/dev/null
+adb -s "$S" pull /data/local/tmp/gpt-secondary.bin "$OUT/gpt-secondary.bin" >/dev/null
+adb -s "$S" shell "su -c 'rm -f /data/local/tmp/gpt-*.bin'" >/dev/null
+say "read $TAIL blocks from each end into $OUT"
+
+# ---- 3. work out the new layout ----
+python3 "$ROOT/mtk/tools/gpt-carve.py" "$OUT/gpt-primary.bin" "$OUT/gpt-secondary.bin" "$TOTAL" \
+    --shrink "$VICTIM" --name "$NAME" --gib "$GIB" --lba-size "$LBA"
+
+# ---- 4. the two images have to agree with each other, and with the disk ----
+python3 - "$OUT/gpt-primary.bin.new" "$OUT/gpt-secondary.bin.new" "$TOTAL" "$LBA" "$NAME" <<'PY' || exit 1
+import struct, sys, binascii
+pri_p, sec_p, total, lba, name = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4]), sys.argv[5]
+
+def load(path, first):
+    """The header and array of one copy, both located through the blocks the header itself names."""
+    d = open(path, "rb").read()
+    i = d.find(b"EFI PART")
+    if i < 0:
+        sys.exit(f"gpt-carve: {path}: no header")
+    sig, rev, hsize, hcrc, _, mylba, altlba, first_u, last_u = struct.unpack_from("<8sIIIIQQQQ", d, i)
+    body = bytearray(d[i:i + hsize])
+    struct.pack_into("<I", body, 0 + 16, 0)
+    if binascii.crc32(bytes(body)) & 0xffffffff != hcrc:
+        sys.exit(f"gpt-carve: {path}: header CRC does not hold")
+    entlba, nent, esz, entcrc = struct.unpack_from("<QIII", d, i + 72)
+    eo = (entlba - first) * lba
+    ents = d[eo:eo + nent * esz]
+    if binascii.crc32(ents) & 0xffffffff != entcrc:
+        sys.exit(f"gpt-carve: {path}: entry array CRC does not hold")
+    return ents, nent, esz, mylba, altlba, first_u, last_u
+
+pc = load(pri_p, 0)
+sc = load(sec_p, total - 34)
+if pc[0] != sc[0]:
+    sys.exit("gpt-carve: the two copies describe different partitions")
+if (pc[3], pc[4]) != (1, total - 1) or (sc[3], sc[4]) != (total - 1, 1):
+    sys.exit(f"gpt-carve: header LBAs are wrong ({pc[3]}/{pc[4]} and {sc[3]}/{sc[4]}, total {total})")
+if pc[5:] != sc[5:]:
+    sys.exit("gpt-carve: the two copies disagree on the usable range")
+
+ents, nent, esz = pc[0], pc[1], pc[2]
+found = False
+for i in range(nent):
+    e = ents[i * esz:(i + 1) * esz]
+    if e[0:16] == b"\0" * 16:
+        continue
+    nm = e[56:128].decode("utf-16-le").rstrip("\0")
+    if nm == name:
+        st, en, _ = struct.unpack_from("<QQQ", e, 32)
+        print(f"xaga-carve: {name} at {st}..{en} ({(en - st + 1) * lba / 2**30:.2f} GiB), block {st * lba}")
+        found = True
+if not found:
+    sys.exit(f"gpt-carve: {name} is not in the new table")
+print(f"xaga-carve: both copies verified against a {total}-block disk of {lba}-byte blocks")
+PY
+
+# ---- 5. write, only when asked ----
+if [ "$WRITE" != 1 ]; then
+    say "nothing written. The commands, if you would rather run them yourself:"
+    printf '  adb -s %s push %s /data/local/tmp/gpt-primary.bin\n' "$S" "$OUT/gpt-primary.bin.new"
+    printf '  adb -s %s push %s /data/local/tmp/gpt-secondary.bin\n' "$S" "$OUT/gpt-secondary.bin.new"
+    printf "  adb -s %s shell \"su -c 'dd if=/data/local/tmp/gpt-primary.bin of=%s bs=%s count=%s conv=notrunc; sync'\"\n" \
+        "$S" "$LUN" "$LBA" "$TAIL"
+    printf "  adb -s %s shell \"su -c 'dd if=/data/local/tmp/gpt-secondary.bin of=%s bs=%s seek=%s count=%s conv=notrunc; sync'\"\n" \
+        "$S" "$LUN" "$LBA" "$SKIP" "$TAIL"
+    printf '  adb -s %s reboot\n' "$S"
+    say "or run this again with --write"
+    exit 0
+fi
+
+say "writing. If anything goes wrong here the phone's partition table is gone:"
+say "  the backup of what is there now is $OUT/gpt-primary.bin and $OUT/gpt-secondary.bin"
+adb -s "$S" push "$OUT/gpt-primary.bin.new" /data/local/tmp/gpt-primary.bin >/dev/null
+adb -s "$S" push "$OUT/gpt-secondary.bin.new" /data/local/tmp/gpt-secondary.bin >/dev/null
+adb -s "$S" shell "su -c 'dd if=/data/local/tmp/gpt-primary.bin of=$LUN bs=$LBA count=$TAIL conv=notrunc'" >/dev/null 2>&1 || \
+    die "writing the primary failed; the old copy is in $OUT and the disk still has it"
+adb -s "$S" shell "su -c 'sync'"
+adb -s "$S" shell "su -c 'dd if=/data/local/tmp/gpt-secondary.bin of=$LUN bs=$LBA seek=$SKIP count=$TAIL conv=notrunc'" >/dev/null 2>&1 || \
+    die "writing the backup failed; the primary is already new, run this again before rebooting"
+adb -s "$S" shell "su -c 'sync'"
+adb -s "$S" shell "su -c 'rm -f /data/local/tmp/gpt-*.bin'" >/dev/null
+say "written. Check before rebooting:"
+say "  adb -s $S shell \"su -c 'ls -l /dev/block/by-name/$NAME'\""
+say "then: adb -s $S reboot"
diff --git a/mtk/tools/xaga-cycle.sh b/mtk/tools/xaga-cycle.sh
new file mode 100755
index 0000000..b8f1034
--- /dev/null
+++ b/mtk/tools/xaga-cycle.sh
@@ -0,0 +1,133 @@
+#!/bin/bash
+# One XNU run on the Redmi Note 11T Pro (xaga, MT6895), where tools/xnu-cycle.sh does not apply.
+#
+# The difference is what the phone can do: lk_a registers no `boot:` command (checked against both
+# the phone's own lk_a.img and the lk.img of the stock ROM in work-xaga/rom), so there is no way to
+# try a kernel out of RAM -- every run is a write to boot_a. And a bad boot_a is a phone that only
+# comes back through fastboot, since there is no recovery partition either. So this script does
+# three things xnu-cycle.sh does not have to:
+#
+#  1. Backs boot_a up before the first write and never overwrites that backup (BACKUP below).
+#  2. Refuses to run unless the backup is there and the phone answers fastboot.
+#  3. Leaves the restore command on screen when anything fails, so a phone that will not boot is
+#     one command from Android again.
+#
+# The rest is xnu-cycle.sh's: build the loader, pack it with the rooted Android boot image, flash
+# boot_a, wait for Android, ask it for one XNU boot through the pmsg zone, wait for the run to end,
+# and pull the kernel's log out of pstore.
+#
+# usage: xaga-cycle.sh [extra flags for mtk/loader/build.sh]
+#   XNU_SECS=45        how long XNU runs before loader_return_after hands back
+#   XNU_ARGS="cpus=4"  the kernel's own command line (must agree with XNU_CORES)
+#   XNU_WATCH=120      the watcher's reset-if-nothing-happens timer
+#   XAGA_SKIP_FLASH=1  do not write boot_a; just run the one XNU boot the phone already has
+set -e
+
+S=${HAKIOS_SERIAL:?set HAKIOS_SERIAL to the serial of your phone, as adb devices shows it}
+ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+BACKUP="$ROOT/backup/boot_a_magisk.img"
+OUT=${XNU_LOG_OUT:-$ROOT/logs/xnu-xaga.log}
+SECS=${XNU_SECS:-45}
+# The kernel's arguments come out of .config (CONFIG_CPUS, CONFIG_FBSCALE, CONFIG_FBFIT, ...), the
+# same way `make phone` gets them. They are not optional decoration: fbfit and fbscale are what make
+# MiniIOMobileFramebuffer scale the 750x1624 picture onto this 1080x2460 panel, and without them a
+# kernel that boots draws nothing. `make xaga_defconfig` has to have been run.
+XNU_ARGS=${XNU_ARGS:-$(cd "$ROOT" && tools/hakios-config.py args 2>/dev/null)}
+[ -n "$XNU_ARGS" ] || { echo "no .config: run 'make xaga_defconfig' first" >&2; exit 1; }
+XNU_WATCH=${XNU_WATCH:-120}
+
+restore_hint() {
+	echo
+	echo "  the phone is not running Android. To put it back:"
+	echo "    fastboot -s $S flash boot_a $BACKUP"
+	echo "    fastboot -s $S reboot"
+	echo
+}
+
+# ---- the backup -------------------------------------------------------------------
+#
+# boot_a is where Magisk lives on this phone (it is rooted), so the backup has to be the phone's
+# own boot image, not the stock one: restoring stock would lose root, and with it the `su -c` that
+# reads the kernel's log out of pstore at the end of every run.
+if [ ! -s "$BACKUP" ]; then
+	echo "no backup at $BACKUP" >&2
+	echo "take it off the phone first, before anything writes boot_a:" >&2
+	echo "  adb -s $S shell 'su -c \"dd if=/dev/block/by-name/boot_a\"' > $BACKUP" >&2
+	echo "(or copy backup/boot_a_magisk.img into place if you already have it)" >&2
+	exit 1
+fi
+echo "backup: $BACKUP ($(wc -c < "$BACKUP") bytes)"
+
+if ! fastboot devices | grep -q "$S"; then
+	echo "the phone is not in fastboot; run: adb -s $S reboot bootloader" >&2
+	exit 1
+fi
+SLOT=$(fastboot -s "$S" getvar current-slot 2>&1 | sed -n 's/^current-slot: //p')
+[ "$SLOT" = a ] || { echo "current slot is '$SLOT', not a: this writes boot_a only" >&2; exit 1; }
+
+# ---- build ------------------------------------------------------------------------
+#
+# DEVICE=xaga is what makes mtk/loader/build.sh pick up mtk/mt6895/loader/board.h; without it the
+# loader is built with the MT6768 defaults and would boot the wrong SoC's addresses.
+#
+# The three settings go as -D flags on the command line, which build.sh passes to clang: it reads
+# no environment of its own (see the "$@" at the end of mtk/loader/build.sh).
+CORES=$(expr "$XNU_ARGS" : '.*cpus=\([0-9]*\)' || true)
+[ -n "$CORES" ] || CORES=4
+TEST_FLAGS=(-DXNU_CORES="$CORES" -DXNU_WATCH_SECONDS="$XNU_WATCH"
+	"-DXNU_RETURN_AFTER=\"$SECS\"" "-DXNU_EXTRA_ARGS=\"$XNU_ARGS epoch=$(date +%s)\"")
+
+echo "building the loader for xaga ($CORES cores, ${SECS}s, ${XNU_WATCH}s watcher)..."
+DEVICE=xaga "$ROOT/mtk/loader/build.sh" "${TEST_FLAGS[@]}" "$@" >/dev/null
+python3 "$ROOT/mtk/loader/build_flashed.py" >/dev/null
+IMG="$ROOT/xnu-flashed-slot_a.img"
+echo "image: $IMG ($(wc -c < "$IMG") bytes, boot_a holds $((64 * 1024 * 1024)))"
+
+# ---- flash and run ----------------------------------------------------------------
+if [ "${XAGA_SKIP_FLASH:-0}" != 1 ]; then
+	echo "flashing boot_a (restore with: fastboot -s $S flash boot_a $BACKUP)"
+	fastboot -s "$S" flash boot_a "$IMG" || { restore_hint; exit 1; }
+	fastboot -s "$S" reboot || { restore_hint; exit 1; }
+	echo "waiting for Android..."
+	for _ in $(seq 1 100); do
+		[ "$(adb -s "$S" get-state 2>/dev/null)" = device ] && break
+		sleep 3
+	done
+	[ "$(adb -s "$S" get-state 2>/dev/null)" = device ] || { restore_hint; exit 1; }
+	sleep 4
+fi
+
+# Android is up: leave the request in the pmsg zone and reboot. mtkloader finds it, boots XNU, and
+# the boot after that is Android again -- loader_return_after and the watcher see to that.
+"$ROOT/mtk/tools/boot-xnu.sh"
+echo "XNU is running; Android comes back by itself after ${SECS}s"
+
+# ---- collect ----------------------------------------------------------------------
+for _ in $(seq 1 $(( (SECS + 300) / 3 ))); do
+	[ "$(adb -s "$S" get-state 2>/dev/null)" = device ] && break
+	sleep 3
+done
+if [ "$(adb -s "$S" get-state 2>/dev/null)" != device ]; then
+	echo "Android did not come back within $(( SECS + 300 ))s" >&2
+	restore_hint
+	exit 1
+fi
+sleep 3
+
+mkdir -p "$(dirname "$OUT")"
+for _ in $(seq 1 10); do
+	adb -s "$S" shell 'su -c "cat /sys/fs/pstore/console-ramoops-0"' > "$OUT" 2>/dev/null || true
+	[ -s "$OUT" ] && break
+	sleep 2
+done
+
+# what the kernel kept for the host (kern.hakios.host_keep), which mtkloader put into the pmsg
+# zone: appended to the log when it is this run's and not Android's own
+adb -s "$S" shell 'su -c "cat /sys/fs/pstore/pmsg-ramoops-0"' > "$OUT.keep" 2>/dev/null || true
+if head -c 64 "$OUT.keep" 2>/dev/null | grep -q 'kept for the host by the kernel'; then
+	{ echo; cat "$OUT.keep"; } >> "$OUT"
+	echo "kept for the host: $(head -1 "$OUT.keep" | sed 's/^=== kept for the host by the kernel: //; s/ ===$//')"
+fi
+rm -f "$OUT.keep"
+
+echo "log: $OUT ($(wc -c < "$OUT") bytes)"
diff --git a/mtk/tools/xaga-first-boot.md b/mtk/tools/xaga-first-boot.md
new file mode 100644
index 0000000..500238a
--- /dev/null
+++ b/mtk/tools/xaga-first-boot.md
@@ -0,0 +1,148 @@
+# xaga 首刷清单（真机到手后照着做）
+
+> 手机：Redmi Note 11T Pro / `xaga` / MT6895 / 已解 BL + root（boot_a 有 KernelSU）
+> 产物：`xnu-flashed-slot_a.img`（22.7 MB，boot_a 分区 64 MiB）
+> 运行脚本：`mtk/tools/xaga-cycle.sh`
+
+## 为什么不能用「试跑」
+
+这台机 `lk_a` 的 fastboot **没有 `boot:` 命令**（手机的 `lk_a.img` 与官方 OS2.0.12 的 `lk.img` 都核过，`boot:` 作命令串出现 0 次），也**没有 recovery 分区**。所以：
+
+- 不能 `fastboot boot` 只进内存试；
+- 每次试验都是写 `boot_a`；
+- 写坏了只能靠 fastboot 救回来。
+
+因此顺序是「先只读验证，再逐层往上」。
+
+## 第 0 步：备份（只做一次，最重要）
+
+```sh
+export HAKIOS_SERIAL=$(adb devices | awk 'NR==2{print $1}')
+mkdir -p backup
+adb -s $HAKIOS_SERIAL shell 'su -c "dd if=/dev/block/by-name/boot_a"' > backup/boot_a_magisk.img
+md5sum backup/boot_a_magisk.img      # 应等于 a63b2e35a7c2522cb24a6a10332b9bc8
+```
+
+这台的 `boot_a` 里是 KernelSU。**不要用官方 stock 当备份**——恢复 stock 会丢 root，之后读 pstore 的 `su -c` 就失效了，而那是唯一能拿到 XNU 日志的路。
+
+仓库里已经放了一份同 md5 的副本，可以先用它核对。
+
+## 第 1 步：先验 UFS 读盘（不碰 Android，不动 boot_a 之外的任何东西）
+
+UFS 驱动是全新写的、从未在真机上跑过。**先单独验证它**，因为后面每一步都依赖它读分区表。
+
+仓库里已经打好了一份 `ufs-test-slot_a.img`（28876 字节的 loader + 同一个 payload），
+不用现编，直接刷：
+
+```sh
+cd /home/lizi/IOS/hakios-mtk
+fastboot -s $HAKIOS_SERIAL flash boot_a ufs-test-slot_a.img
+fastboot -s $HAKIOS_SERIAL reboot
+```
+
+要自己重打则：
+
+```sh
+cd /home/lizi/IOS/hakios-mtk
+DEVICE=xaga ./mtk/loader/build.sh -DUFS_TEST=1
+python3 mtk/loader/build_flashed.py
+mv xnu-flashed-slot_a.img ufs-test-slot_a.img   # 主镜像别被这个版本覆盖
+DEVICE=xaga ./mtk/loader/build.sh               # 恢复常规模块
+python3 mtk/loader/build_flashed.py
+```
+
+⚠️ `-DUFS_TEST=1` 版**不含** XNU 跳转代码（编译器把后续当死代码删了），它是纯自检镜像，跑完自己回 Android。
+
+**看屏幕**（LK 的 framebuffer 上会打出来）：
+- `== mtkloader: UFS read test ==`
+- 控制器状态、TEST UNIT READY 的结果
+- `ufs: unit 2: N blocks of 4096 bytes` ← READ CAPACITY(10) 问出的真实逻辑块大小
+- **`GPT header: block 4096: EFI PART, entries at 2 count 128`** ← 这一行是关键。它先探测块大小
+  （512 不行就 4096），再用那个块大小去读 header。真机上答的应该是 **4096**
+- `boot_a LBA ...: ANDROID! kernel_size ...`
+- 256 KB 读的耗时
+
+**判断**：
+- 能看到 GPT 与 `ANDROID!` → UFS 通了，进第 2 步
+- `GPT header: block 0` → 512 和 4096 都没找到 header，说明 LUN 或控制器接管有问题
+- `GPT header: block 4096: read, but not a GPT header: ...` → 读到了但内容不对，把后面 8 个字节拍照
+- 打印 `logical block size is neither 512 nor 4096` → 设备给的块长是别的值，把屏幕拍照
+- 卡住不动 → 等 120 秒看门狗自己重启回 Android；若没回来，用第 5 步救砖
+- 打印了错误码 → 把屏幕拍照，错误码在 `ufs.h` 里有对应含义
+
+### 为什么会有这次修复
+
+`gpt_find()` 原来假设扇区是 512 字节，写的是 `board_read(1, 1, ...)` 再比对 `EFI PART`。
+xaga 的 UFS 逻辑块是 **4096**（真机 `/sys/block/sdc/queue/logical_block_size` 实测），
+GPT header 在 **byte 4096**，而 byte 512..1023 是保留区的全零。所以那行比对**永远失败**，
+`load_system_image` 会打印 `no xnusys partition` 然后返回 0 —— XNU 就没有 md0，卡在
+`Still waiting for root device`。
+
+连带的两处同源错误也一起修了：条目表地址必须乘块大小（`ent_lba * 4096`，不是 `* 512`），
+分区大小的 MB 显示原来按 512 算会显示成真实值的 1/8。
+
+## 第 2 步：验证显示链路
+
+UFS 通了之后，跑真 XNU 首刷。这一步要验证的是：`mtkloader` 能进、`chain_stub` 能把 Android 的 `Image` 搬回原位、XNU 能起、能打印。
+
+```sh
+mtk/tools/xaga-cycle.sh
+```
+
+它会：备份检查 → 编译 → 打镜像 → 刷 boot_a → 重启 → 等 Android 起来 → 通过 pmsg 请求一次 XNU → 等 XNU 跑完（45 秒）→ 自动回 Android → 把日志抓下来。
+
+**看屏幕**：
+- `== mtkloader: Darwin/XNU on XAGA (MT6895) ==` —— 到了这行说明 loader 起来了
+- `LK dtb 0x...` —— 设备树地址
+- `boot: Darwin / XNU (requested)` —— pmsg 请求被识别
+
+**XNU 起来后应该能看到**（串口/屏幕二者之一，取决于 LK 留了什么）：
+- 苹果 logo 之前是没有的（没有 bootlogo 阶段）
+- 内核的早期打印
+
+**回来之后**：
+```sh
+cat logs/xnu-xaga.log
+```
+
+**判断**：
+- 有 XNU 的内核打印（`Darwin Kernel Version ...`）→ 内核跳转成功，最大的一关过了
+- 只有 `mtkloader` 的打印、没有内核的 → loader 起来了但跳转失败，多半是 `KERNEL_PA` / `chain_stub` 的问题
+- 什么都没有 → 显示链路问题，回去核 `OVL0_BASE` 与 `LK_FB_BASE`
+
+## 第 3 步：确认自动回滚
+
+上面每一步都靠 `loader_return_after=45`（XNU 跑 45 秒后自己交还）和 `XNU_WATCH_SECONDS=120`（watcher 核 120 秒没动静就复位）。这两个值在 `board.h` 里。
+
+**故意验证一次**：跑 `XNU_SECS=10 mtk/tools/xaga-cycle.sh`，看是不是 10 秒就回 Android。如果不回，说明自动回滚没生效，后面的试验会很难受。
+
+## 第 4 步：往「能看见界面」推
+
+`hakios-kernel` 里有完整的 framebuffer 驱动（`MiniIOMobileFramebuffer`，含 `fbfit`/`fbscale` 的三种缩放分支），但**没有任何 MTK 驱动**（`strings hakios-kernel | grep -ic mediatek` = **0**）。所以第 2 步成功后，画面会是内核自己画的东西，不是 iOS 界面。
+
+要往界面推，缺的是（按重要性）：
+1. **触控** —— xaga 是 Novatek NT36672E（`novatek,NVT-ts-spi`，SPI2，GPIO 109/110/111/112，IRQ GPIO135），而 `tcm.h` 是 OmniVision TD4160 的协议，完全不同。要新写一个 Novatek 的 SPI 驱动。
+2. **GPU** —— xaga 是 Mali-G610（`arm,mali-valhall` @ `0x13000000`），`mtkmali.h` 是 G52 MC2（`0x13040000`）的，寄存器不同。
+3. **UFS 块设备** —— 现在 loader 能读盘，但内核里没有块设备。`hakios.ufshc.c` 假设 UEFI 的 UFSDxe 常驻（高通场景），MTK 这边没有对应的东西。
+4. **Wi-Fi** —— CONNSYS 新一代，`mtkconnsys.h` 是旧的。
+
+## 第 5 步：救砖
+
+任何时候卡住/黑屏/不进 Android：
+
+```sh
+# 长按电源键 15 秒强制关机，然后 音量下 + 电源 进 fastboot
+fastboot devices
+fastboot -s $HAKIOS_SERIAL flash boot_a backup/boot_a_magisk.img
+fastboot -s $HAKIOS_SERIAL reboot
+```
+
+如果连 fastboot 都进不去：MTK 的 BROM 模式（关机状态下按住两个音量键插 USB），用 SP Flash Tool 刷官方 ROM 的 `boot.img`。官方包在 `/home/lizi/下载/xaga_images_OS2.0.12.0.ULOCNXM_14.0.zip`。
+
+## 每步之间记什么
+
+每次跑完都存一份日志（`xaga-cycle.sh` 自动存到 `logs/xnu-xaga.log`），并且**拍下屏幕**。因为屏幕上的信息（`mtkloader` 的横幅、OVL 的寄存器值）在 pstore 里不一定有。
+
+特别要记的两个数：
+- `boot: Darwin / XNU (requested)` 有没有出现 —— 判断 pmsg 通道
+- `display_alpha_off` 打印的 OVL L0_CON 新旧值 —— 这是核实 `OVL_L0_CON 0x030` 偏移对不对的唯一途径（xaga 的 DT 里 `0x1400b000` 是 ccorr1 不是 OVL0，三棵源码树都没有 OVL 寄存器头文件，无法离线核实）
diff --git a/mtk/tools/xaga-input.md b/mtk/tools/xaga-input.md
new file mode 100644
index 0000000..94c8b18
--- /dev/null
+++ b/mtk/tools/xaga-input.md
@@ -0,0 +1,243 @@
+# xaga 的输入：触控、按键，以及还不能用的 USB
+
+这一页只写 xaga（Redmi Note 11T Pro，MT6895）。两台参考板（x6826b 的 MT6768、
+redwood 的高通）在输入上每一处都不一样，所以下面每条都标注了出处，能拿真机二进制核对的
+都核对过了，不靠推测。
+
+## 一、现状
+
+进入 iOS 桌面这一步已经打通。桌面能画出来、SpringBoard 能跑、`36 checks, 0 failed`。
+进去之后发现三样东西不响应：
+
+| 部件 | 状态 | 驱动 | boot-arg |
+|---|---|---|---|
+| 触控 | 已写，待真机验证 | `mtk/mt6895/drivers/input/hakios.nvt.c` | `touchscreen=3` |
+| 音量 / 电源键 | 已写第二版，待真机验证 | `mtk/mt6895/drivers/input/hakios.mt6895_keys.c` | `buttons=2` |
+| USB（含外接鼠标） | **没有实现** | 无 | —— |
+
+USB 是空的：`find xnu/files -ipath "*usb*"` 零命中，内核里连 USB 栈的骨架都没有。
+这一项不是「配错了开关」，是要从 MTU3 / xHCI 的设备栈写起。
+
+## 二、触控：Novatek NT36672E
+
+### 硬件在哪
+
+从 `work-xaga/dump/xaga_live.dts` 和 `kx/arch/arm64/boot/dts/vendor/mediatek/xaga-mt6895-touch.dtsi`：
+
+```
+spi2 @ 0x11012000   compatible "mediatek,mt6983-spi"
+  novatek@0         compatible "novatek,NVT-ts-spi"
+                    spi-max-frequency   13000000
+                    novatek,irq-gpio    <&pio 135 0x2001>
+                    novatek,swrst-n8-addr 0x03F0FE
+                    novatek,spi-rd-fast-addr 0x03F310
+```
+
+引脚（全部 `SPI2_A_*` 复用）：
+
+| 信号 | GPIO |
+|---|---|
+| MI（MISO） | 109 |
+| CS | 110 |
+| MO（MOSI） | 111 |
+| CLK | 112 |
+| INT | 135 |
+
+控制器是 **NT36672E**：固件名 `novatek_nt36672e_l16_fw01.bin`（Tianma，tp-vendor `0x46`）
+与 `fw02.bin`（CSOT，`0x53`）。本机面板 cmdline 是 `panel-l16-42-02-0a-dsc-vdo`，属 Tianma 批次。
+
+芯片跑自己 flash 里的固件，**上电就能报点，不需要下发固件**。
+
+### 为什么用 GPIO 手推而不是 SPI 控制器
+
+MT6895 的 `SPI2_A_*` 引脚功能号在任何可得头文件里都只以宏名出现
+（`PINMUX_GPIO110__FUNC_SPI2_A_CSB`），没有数字。当 GPIO 用不需要那个数字。
+代价是速率：66 字节按 100 kHz 推不到 1 ms，而报点周期是 8 ms 量级，够。
+
+### 协议（四处关键点，全部由真机 `nvt36672c.ko` 反汇编确认）
+
+模块在 `work-xaga/dt-device_xiaomi_xaga-TWRP/recovery/root/lib/modules/nvt36672c.ko`
+（380528 B，未 strip）。反汇编存 `/tmp/nvt.txt`。
+
+1. **一次读的总线字节数 = 报告长度 + 2。**
+   仓库里的 Linux 源码 `CTP_SPI_READ(buf, POINT_DATA_LEN + 1)` 传的是 66，模块内部
+   `t.len = len + DUMMY_BYTES`（`DUMMY_BYTES 1`）⇒ 总线上 67 字节；返回后
+   `memcpy(dst + 1, rbuf + 2, len - 1)`，报告落在 `rbuf[2..]`。
+   驱动里对应 `spi_xfer(out, in, len + 2)`。
+
+2. **校验和覆盖报告的第 0..63 字节，比对第 64 字节。**
+   模块 `nvt_ts_work_func` 的循环：`i = 1`，`sum += buf[i]`，`cmp x8, #0x40` 相等才退出
+   ⇒ 累加 `buf[1..0x40]`，校验字节取 `buf[0x41]`。`buf[0]` 是地址字节
+   （`CTP_SPI_READ` 里 `and w8, w8, #0x7f; strb w8, [x19]` 写回），整体前移一格就得到
+   上面的表述。
+
+3. **第 i 指从报告的第 `6*i` 字节起。**
+   模块里 `position = 1 + 6*i` 是 `buf` 坐标，`buf[0]` 是地址 ⇒ 换算过来是 `6*i`。
+   每指 6 字节：`[0] = (id << 3) | state`（1 = down，2 = move），
+   `x = (pd[1] << 4) | (pd[3] >> 4)`，`y = (pd[2] << 4) | (pd[3] & 0x0f)`，`[4]` 压力。
+
+4. **INT 是高电平有效。**
+   `nt36xxx.h:53 #define INT_TRIGGER_TYPE IRQ_TYPE_EDGE_RISING`。空闲时是低，
+   固件跑起来有数据才拉高。
+
+### page 必须锁存一次
+
+`nvt_ts_work_func` 读点数据**前不调 `nvt_set_page`**：page 在 probe 时锁存一次，
+之后读地址 0 就等于读 `EVENT_BUF_ADDR`。驱动里线程启动时 `nvt_set_page(page)` 一次，
+之后 `nvt_read(0, data, POINT_DATA_LEN)`。
+
+默认 `NVT_EVENT_BUF_ADDR 0x21C00`，来自 NT36672A 的 map（`nt36xxx_mem_map.h:127`）。
+本机是 NT36672E，`trim_id_table` 里没有 E 的条目，所以做成 boot-arg `nvt_page` 可覆盖。
+page 机制自洽：`0x21C00 & ~0x7f == 0x21C00`，`0x21C00 | 0x78 == 0x21C78` 同 page。
+
+### GPIO 寄存器布局（真机 `pinctrl-mt6895.ko` 的 reg_cal 表逐字确认）
+
+模块 `.rodata` 里有连续表：`0x6438`（DIR 组）、`0x64d8`（DOUT 组）、`0x6578`（DIN 组）、
+`0x61f4`（MODE 组，`bitstart=0 len=4`）。表项 20 字节，偏移在 `+8`：
+
+```
+DIR   0x000 + n*0x10     n = pin / 32
+DOUT  0x100 + n*0x10     实际写入用 +0x104 set / +0x108 clr
+DIN   0x200 + n*0x10
+MODE  0x300 + (pin / 8)*0x10，脚内偏移 (pin % 8) * 4 位，4 位宽
+```
+
+xaga 用的五个脚落在 `0x3d0`（109/110/111）、`0x3e0`（112）、`0x400`（135）。
+
+**这一条踩过坑**：仓库里 MT6768 的参考实现（`mtk/mt6768/drivers/input/hakios.tcm.c`）
+把 DIR/DOUT 写成固定的 `0x004/0x104/0x200`，因为它用的引脚 25-28 全在第 0 组。
+xaga 的 109-135 不在第 0 组，照抄会操作错寄存器。
+
+### 一次启动就能判断是没电还是协议错
+
+驱动在锁存 page 之后打印：
+
+```
+nvt: at rest GPIO135 is 1; the input register of its group reads 0x...,
+     the group of the bus pins reads 0x...
+```
+
+INT 空闲应该是 1。一直是 0 说明芯片没出复位，读总线不会有意义——先查供电
+（`mt6368_vtp`，`/spmi@1c804000/second_pmic@5/regulators/VTP`，由 LK 打开），
+而不是改协议。
+
+## 三、按键：SoC keypad + PMIC
+
+### 两套硬件，不是一套
+
+| 键 | 走哪 | 依据 |
+|---|---|---|
+| 音量下 | SoC keypad 行 0 | `mt6895.dts:2053` 的 `hw-init-map = <114 0 0 ...>` |
+| 音量上 | SoC keypad 行 17 | `cust/xaga.dtsi:381-390` 的 `mediatek,hw-rstkey = <17>` |
+| 电源 | SoC keypad 行 8 **和** MT6363 | `mediatek,hw-pwrkey = <8>`；`mt6363.dtsi:108-122` 也有 `power { linux,keycodes = <116> }` |
+
+`xaga_live.dts` 里 dump 出来的 keypad 只剩 `hw-init-map = <0x72>`（114），
+是因为那一份是 bootloader 打过补丁的形态，`hw-pwrkey` 之类的属性没写进去。
+源头的 `cust/xaga.dtsi` 才是完整的。
+
+### keypad 寄存器布局（真机 `mtk-kpd.ko` 反汇编确认）
+
+模块在 `work-xaga/dt-device_xiaomi_xaga-TWRP/recovery/root/lib/modules/mtk-kpd.ko`
+（26400 B，未 strip）。反汇编存 `/tmp/kpd.txt`。
+
+**读状态**（`kpd_get_keymap_state @0x930`）：用 **`ldrh`（16 位）** 依次读
+`base+0x04`、`+0x08`、`+0x0c`、`+0x10`、`+0x14`，写进 uint16 数组，每读之前 `dmb oshld`。
+
+⇒ 5 个 16 位寄存器，起始 `+0x04`，步长 4，共 80 位（与 `hw-map-num = 0x48` = 72 吻合）。
+
+**极性**（`kpd_keymap_handler`）：
+
+```
+7bc: lsl  w8, w27, w21        /* 1 << bit */
+7d4: ands w23, w8, w28        /* 新值里这一位是 1 吗 */
+810: cset w3, eq              /* eq ⇒ 新值为 0 ⇒ pressed */
+```
+
+⇒ **位为 0 = 按下，位为 1 = 松开**。索引 `index = 寄存器号 * 16 + bit`，上限 71。
+
+**上电必做的两个写**（`kpd_pdrv_probe`）：
+
+```
+380: add x22, x9, #0x20      /* base+0x20，置 bit0 = 使能 */
+388: strh w21, [x22]
+3e0: add x22, x9, #0x18      /* base+0x18，bits 13:0 = debounce */
+3e8: strh w23, [x22]
+```
+
+不做这两个，keypad 不工作。
+
+**中断不用清**（`kpd_irq_handler @0x8a0`）：只做原子置位 + `tasklet_schedule`，
+不写硬件清中断 ⇒ 中断是电平/自动清除。驱动用轮询，不需要中断。
+
+### 板级注意
+
+`work-xaga/dump/iomem.txt` 的 `1c0` 段只有 `1c001000.power-controller`、
+`1c007000.watchdog`、`1c00f000.dvfsrc`、`1c013000.syscon` —— **`0x1c00e000` 没出现**。
+DTS 里有节点、ko 也存在，所以它是能用的，只是 Android 起来后那个映射被回收了。
+loader 阶段（MMU 关闭）访问它要小心总线错误：驱动在读之前先读一遍五个寄存器，
+若全 `0xffff` 或全 0 就打印并退出，不去写使能位——因为没有异常向量，总线 abort 会挂死整机。
+
+## 四、USB：还没有
+
+内核里没有任何 USB 代码。要做的话，可参考的真机模块都在同一个 TWRP 目录：
+
+```
+mtu3.ko            372560 B   设备控制器
+xhci-mtk-hcd.ko     65232 B   主机控制器
+extcon-mtk-usb.ko             线缆检测
+usb_dp_selector.ko            DisplayPort 切换
+```
+
+`mtu3.ko` 是 Linux 的 DRD 驱动，寄存器序列可以直接对照；但 xHCI 那一层要自己写。
+这一项工作量远大于触控和按键。
+
+## 五、构建与验证
+
+```bash
+cd /home/lizi/IOS/hakios-mtk && source xnu-env.sh
+
+# 内核（必须 LC_ALL=C，否则 tools/make-kernel.sh 的失败判定被中文 locale 卡住）
+LC_ALL=C make kernel DEVICE=xaga
+
+# loader 镜像
+DEVICE=xaga ./mtk/loader/build.sh -DBOARD_NO_UART -DBOARD_NO_OVL -DBOARD_SKIP_MENU \
+  -DBOARD_NO_CONNSYS -DXNU_CORES=4 -DXNU_VERBOSE=0 -DXNU_DISPLAY=1 \
+  -DXNU_WATCH_SECONDS=0 -DXNU_RETURN_AFTER='"180"'
+make payload DEVICE=xaga
+python3 mtk/loader/build_flashed.py
+
+# 刷
+fastboot -s GAJZ4HIN99AQ69Y9 flash boot_a xnu-flashed-slot_a.img
+fastboot -s GAJZ4HIN99AQ69Y9 reboot
+```
+
+boot-arg 在 `mtk/mt6895/loader/board.h` 的 `XNU_EXTRA_ARGS`，当前是
+
+```
+cpus=4 touchscreen=3 buttons=2 keylog=2 touch_raw=1
+```
+
+`CONFIG_BOOTARGS` **不进 loader**：`mtk/loader/build.sh` 完全不读 `.config`。
+loader 用的是 `mtkloader.c` 里的 `XNU_BOOT_ARGS`。要改运行参数只能改 `board.h`。
+
+`keylog=2` 只为首批启动用，寄存器偏移定准后应当删掉——logbook 只有 4 MB，
+和内核日志共享，每 60 秒 dump 16 个寄存器会在一轮启动内把日志填满。
+
+取日志：
+
+```bash
+sh mtk/tools/xaga-pull-log.sh        # → xaga-logbook.bin
+```
+
+loader 跑完会自动起 Android（`BOARD_RETURN_TO_ANDROID 1`），所以 adb 会回来，
+不用手动复位。这个板的 `reset_board()` 两条路都无效——PSCI system reset
+（`smc #0 0x84000009`）返回但不动作，裸 `TOPRGU_SWRST` 也被忽略。唯一实测能把
+这块板子复位的是**带 LENGTH 编程的看门狗**：
+
+```c
+wr32(TOPRGU_LENGTH, ((seconds * 32768u / 512u) << 5) | 0x8u);
+wr32(TOPRGU_RESTART, TOPRGU_RESTART_KEY);
+wr32(TOPRGU_MODE, TOPRGU_MODE_KEY | 0x1u);
+```
+
+不给 `TOPRGU_LENGTH` 编程，`RESTART` 和 `SWRST` 都是空写。
