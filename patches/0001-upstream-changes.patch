+			    ((volatile uint32_t *) window)[(at + 0x0c) / 4],
+			    ((volatile uint32_t *) window)[(at + 0x14) / 4],
+			    ((volatile uint32_t *) window)[(0x0f40 + 0x20 * layer) / 4]);
+		}
+	}
+	for (size_t i = 0; i < sizeof(rows) / sizeof(rows[0]); i++) {
+		vm_offset_t window = ml_io_map((vm_offset_t) (rows[i].where & ~(uint64_t) (PAGE_SIZE - 1)), PAGE_SIZE);
