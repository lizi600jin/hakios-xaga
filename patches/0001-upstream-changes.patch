+ * the instruction never returns.  What that looks like from outside is a screen showing
+ * everything drawn before the first delay and nothing after it, which is exactly the shape of
+ * the hang this board has been showing.  So: a counter that costs one register, and delays
+ * that are counted instructions.
+ */
+static uint32_t dbg_soft_ticks;
+
+static inline uint64_t dbg_ticks(void) { return ++dbg_soft_ticks; }
+static inline uint64_t dbg_freq(void) { return 1000000u; }
