index 0000000..a74d5c2
--- /dev/null
+++ b/mtk/tools/mkfont8x16.py
@@ -0,0 +1,210 @@
+#!/usr/bin/env python3
+"""
+mkfont8x16.py -- Swift-free reimplementation of tools/mkfont8x16.swift.
+
+Rasterizes printable ASCII (0x20..0x7e) from a vector monospace font into an
+8x16 1-bit font and emits it as a C header, format-compatible with the
+original Swift tool:
+
+    /* Generated by ... */
+    static const unsigned char font8x16[95][16] = {
+        { 0x00,0x00,...,0x00 }, /* <char> */
+        ...
+    };
+
+- 16 rows per glyph, one byte per row, MSB = leftmost pixel (0x80 >> x).
+- Comment uses the character itself, except 0x5c -> "backslash" and
+  0x2a -> "asterisk" so "*/" never appears inside a C comment.
+- Rows are thresholded from 8-bit grayscale coverage: bit set iff gray > 100
+  (same threshold as the Swift tool).
+
+The Swift original drew into an 8x16 device-gray context with the glyph
+origin at (x=0, y=4) -- baseline 4 px above the cell bottom. This script
+renders at high resolution then scales down, and centers the glyph ink in
+the cell per-axis, so descenders (g j p q y) stay visible and glyphs are
+optically centered; underscores sit near the bottom as expected.
+
+Usage:
+    python3 mkfont8x16.py [--font PATH] [--out PATH] [--no-preview]
+
+Font priority (first existing wins):
+    1. /usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf   (default)
+    2. /usr/share/fonts/truetype/liberation/LiberationMono-Bold.ttf
+    3. /usr/share/fonts/truetype/noto/NotoSansMono-Regular.ttf
+"""
+
+import argparse
+import os
+import sys
+
+try:
+    from PIL import Image, ImageDraw, ImageFont
+except ImportError:
+    sys.stderr.write("error: Pillow (PIL) is required: pip3 install Pillow\n")
+    sys.exit(1)
+
+W, H = 8, 16
+THRESHOLD = 100          # same "> 100" gray threshold as the Swift tool
+SS = 16                  # supersample factor: render 128x256, box-down to 8x16
+GENERATED_BY = "tools/mkfont8x16.py"
+
+FONT_CANDIDATES = [
+    "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf",
+    "/usr/share/fonts/truetype/liberation/LiberationMono-Bold.ttf",
+    "/usr/share/fonts/truetype/noto/NotoSansMono-Regular.ttf",
+]
+
+
+def pick_font(user_path):
+    if user_path:
+        return user_path
+    for p in FONT_CANDIDATES:
+        if os.path.isfile(p):
+            return p
+    raise SystemExit("error: no candidate monospace TTF found on this system")
+
+
+def find_pixel_size(font_path):
+    """Pick the largest pixel size (of SS-scaled units) whose advance fits the
+    8px cell width. Mirrors Menlo Bold 13pt of the Swift tool."""
+    for px in range(14, 7, -1):
+        f = ImageFont.truetype(font_path, px * SS)
+        if f.getlength("M") <= W * SS:
+            return px, f
+    raise SystemExit("error: font advance wider than the 8px cell")
+
+
+BASELINE_ROW = 12  # baseline sits 4px above the cell bottom, like Swift's y=4
+
+
+def render_char(font, code):
+    """Render one ASCII code into an (H rows of W bytes) list, MSB = left."""
+    ch = chr(code)
+    big = Image.new("L", (W * SS, H * SS), 0)
+    d = ImageDraw.Draw(big)
+    # textbbox with anchor at top-left of the ascender box: (x0, y0, x1, y1);
+    # y0/y1 are relative to the anchor line. Draw so the BASELINE lands on
+    # BASELINE_ROW and the ink is horizontally centered in the cell.
+    bbox = d.textbbox((0, 0), ch, font=font)
+    ascent = font.getmetrics()[0]
+    ink_w = bbox[2] - bbox[0]
+    x = ((W * SS - ink_w) // 2) - bbox[0]
+    y = BASELINE_ROW * SS - ascent
+    d.text((x, y), ch, font=font, fill=255)
+    small = big.resize((W, H), Image.BOX)
+    px = small.load()
+    rows = []
+    for yy in range(H):
+        b = 0
+        for xx in range(W):
+            if px[xx, yy] > THRESHOLD:
+                b |= 0x80 >> xx
+        rows.append(b)
+    return rows
+
+
+def check_clipping(font):
+    """Warn (stderr) if any glyph ink would be clipped by the 8x16 cell."""
+    d = ImageDraw.Draw(Image.new("L", (8, 8)))
+    for code in range(0x20, 0x7F):
+        bbox = d.textbbox((0, 0), chr(code), font=font)  # anchor "la": y=0 = ascender
+        ascent = font.getmetrics()[0]
+        top = BASELINE_ROW + ((bbox[1] - ascent) // SS)  # rows above baseline
+        bot = BASELINE_ROW + ((bbox[3] - ascent) // SS)  # rows below baseline
+        if top < 0 or bot > H - 1:
+            print("warning: %r ink out of cell (top=%d bot=%d)" % (chr(code), top, bot),
+                  file=sys.stderr)
+
+
+def comment_for(code):
+    if code == 0x5C:
+        return "backslash"
+    if code == 0x2A:
+        return "asterisk"
+    return chr(code)
+
+
+def emit_header(font):
+    lines = []
+    lines.append(
+        "/* Generated by %s: DejaVu Sans Mono Bold, ASCII 0x20-0x7e, 8x16, MSB = left. */"
+        % GENERATED_BY
+    )
+    lines.append("static const unsigned char font8x16[95][16] = {")
+    for code in range(0x20, 0x7F):
+        rows = render_char(font, code)
+        rows_s = ",".join("0x%02x" % b for b in rows)
+        lines.append("    { %s }, /* %s */" % (rows_s, comment_for(code)))
+    lines.append("};")
+    return "\n".join(lines) + "\n"
+
+
+def ascii_selfcheck(font, codes=(0x41, 0x67, 0x4D, 0x30, 0x5F)):
+    """Print A g M 0 _ as '#'/'.' bitmaps for human verification."""
+    for code in codes:
+        rows = render_char(font, code)
+        print("0x%02x '%s':" % (code, comment_for(code)))
+        for b in rows:
+            print("    " + "".join("#" if b & (0x80 >> x) else "." for x in range(W)))
+        print()
+
+
+def emit_preview(font, out_path, scale=3):
+    """Render all 95 chars into a grid PNG, each cell scaled by `scale`."""
+    cols = 16
+    rows_n = (95 + cols - 1) // cols  # 6 rows
+    pad = scale
+    img = Image.new("L", (cols * (W * scale) + pad * (cols + 1),
+                          rows_n * (H * scale) + pad * (rows_n + 1)), 40)
+    for i, code in enumerate(range(0x20, 0x7F)):
+        r = render_char(font, code)
+        gx = i % cols
+        gy = i // cols
+        cell = Image.new("L", (W, H), 0)
+        cp = cell.load()
+        for y in range(H):
+            for x in range(W):
+                cp[x, y] = 255 if r[y] & (0x80 >> x) else 0
+        cell = cell.resize((W * scale, H * scale), Image.NEAREST)
+        ox = pad + gx * (W * scale + pad)
+        oy = pad + gy * (H * scale + pad)
+        img.paste(cell, (ox, oy))
+    img.save(out_path)
+    return out_path
+
+
+def main():
+    ap = argparse.ArgumentParser(description="Generate 8x16 ASCII C font header (no Swift).")
+    ap.add_argument("--font", help="path to a .ttf monospace font (default: auto-pick)")
+    ap.add_argument("--out", default=None, help="output header path (default: print to stdout)")
+    ap.add_argument("--preview", default="/tmp/font8x16_preview.png",
+                    help="preview PNG path (default /tmp/font8x16_preview.png)")
+    ap.add_argument("--no-preview", action="store_true", help="skip PNG preview")
+    args = ap.parse_args()
+
+    font_path = pick_font(args.font)
+    size, font = find_pixel_size(font_path)
+    print("font: %s (pixel size %d/16 at SS=%d)" % (font_path, size, SS),
+          file=sys.stderr)
+    check_clipping(font)
+
+    text = emit_header(font)
+
+    # Human-eye self check on the terminal (stderr, so stdout stays clean for
+    # `python3 mkfont8x16.py > font8x16.h` drop-in usage).
+    ascii_selfcheck(font)
+
+    if args.out:
+        with open(args.out, "w") as f:
+            f.write(text)
+        print("wrote %s" % args.out, file=sys.stderr)
+    else:
+        sys.stdout.write(text)
+
+    if not args.no_preview:
+        p = emit_preview(font, args.preview)
+        print("preview: %s" % p, file=sys.stderr)
+
+
+if __name__ == "__main__":
+    main()
