+	[ -f "$BOARD" ] || { echo "mtkloader: no board header at $BOARD" >&2; exit 1; }
+	CFLAGS="$CFLAGS -DBOARD_HEADER=\"$BOARD\""
+	echo "mtkloader: board $BOARD"
+fi
