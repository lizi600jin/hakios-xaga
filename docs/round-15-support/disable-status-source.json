      "static int wait_mcu_status_value(struct kbase_device *kbdev, u32 val)",
      "{",
      "\tu32 max_loops = CSF_MAX_FW_STOP_LOOPS;",
      "",
      "\t/* wait for the MCU_STATUS register to reach the given status value */",
      "\twhile (--max_loops &&",
      "\t       (kbase_reg_read(kbdev, GPU_CONTROL_REG(MCU_STATUS)) != val)) {",
      "\t}",
      "",
      "\treturn (max_loops == 0) ? -1 : 0;",
      "}",
      "",
      "void kbase_csf_firmware_disable_mcu_wait(struct kbase_device *kbdev)",
      "{",
      "\tif (wait_mcu_status_value(kbdev, MCU_CNTRL_DISABLE) < 0)",
      "\t\tdev_err(kbdev->dev, \"MCU failed to get disabled\");",
      "}",
      "",
