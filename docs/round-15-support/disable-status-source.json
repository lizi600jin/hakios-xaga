      "static void panthor_fw_stop(struct panthor_device *ptdev)",
      "{",
      "\tstruct panthor_fw *fw = ptdev->fw;",
      "\tu32 status;",
      "",
      "\tgpu_write(fw->iomem, MCU_CONTROL, MCU_CONTROL_DISABLE);",
      "\tif (gpu_read_poll_timeout(fw->iomem, MCU_STATUS, status,",
      "\t\t\t\t  status == MCU_STATUS_DISABLED, 10, 100000))",
      "\t\tdrm_err(&ptdev->base, \"Failed to stop MCU\");",
      "}",
