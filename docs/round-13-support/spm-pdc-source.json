      "#define MFG_1_12_PWR_MASK               (0x3FFC)       /* 0011 1111 1111 1100 */",
      "",
      "/**************************************************",
      " * Shader Core Setting",
      " **************************************************/",
      "#define MFG3_SHADER_STACK0              (T0C0 | T0C1)   /* MFG7, MFG9 */",
