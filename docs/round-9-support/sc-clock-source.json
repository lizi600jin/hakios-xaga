      "static int mtk_clk_mux_enable_setclr(struct clk_hw *hw)",
      "{",
      "\tstruct mtk_clk_mux *mux = to_mtk_clk_mux(hw);",
      "\tunsigned long flags = 0;",
      "",
      "\tif (mux->lock)",
      "\t\tspin_lock_irqsave(mux->lock, flags);",
      "\telse",
      "\t\t__acquire(mux->lock);",
      "",
      "\tregmap_write(mux->regmap, mux->data->clr_ofs,",
      "\t\tBIT(mux->data->gate_shift));",
      "",
      "\t/*",
      "\t * If mux setting restore after vcore resume, it will",
      "\t * not be effective yet. Set the update bit to ensure the mux gets",
      "\t * updated.",
      "\t */",
      "\tregmap_write(mux->regmap, mux->data->upd_ofs,",
      "\t\tBIT(mux->data->upd_shift));",
      "",
      "\tif (mux->lock)",
      "\t\tspin_unlock_irqrestore(mux->lock, flags);",
      "\telse",
      "\t\t__release(mux->lock);",
      "",
      "\treturn 0;"
    ]
