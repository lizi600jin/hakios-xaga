    "lines": [
      "static int kbase_pm_do_reset(struct kbase_device *kbdev)",
      "{",
      "\tstruct kbasep_reset_timeout_data rtdata;",
      "\tint ret;",
      "#if IS_ENABLED(CONFIG_MALI_MTK_DEBUG)",
      "#if IS_ENABLED(CONFIG_MTK_IRQ_DBG)",
      "\tint i;",
      "\tunsigned int irq;",
      "#endif",
      "#endif",
      "",
      "\tKBASE_KTRACE_ADD(kbdev, CORE_GPU_SOFT_RESET, NULL, 0);",
      "",
      "\tKBASE_TLSTREAM_JD_GPU_SOFT_RESET(kbdev, kbdev);",
      "",
      "\tif (kbdev->pm.backend.callback_soft_reset) {",
      "\t\tret = kbdev->pm.backend.callback_soft_reset(kbdev);",
      "\t\tif (ret < 0)",
      "\t\t\treturn ret;",
      "\t\telse if (ret > 0)",
      "\t\t\treturn 0;",
      "\t} else {",
      "\t\tkbase_reg_write(kbdev, GPU_CONTROL_REG(GPU_COMMAND),",
      "\t\t\t\tGPU_COMMAND_SOFT_RESET);",
      "\t}",
      "",
      "\t/* Unmask the reset complete interrupt only */",
      "\tkbase_reg_write(kbdev, GPU_CONTROL_REG(GPU_IRQ_MASK), RESET_COMPLETED);",
      "",
      "\t/* Initialize a structure for tracking the status of the reset */",
      "\trtdata.kbdev = kbdev;",
      "\trtdata.timed_out = false;",
      "",
      "\t/* Create a timer to use as a timeout on the reset */",
      "\thrtimer_init_on_stack(&rtdata.timer, CLOCK_MONOTONIC, HRTIMER_MODE_REL);",
      "\trtdata.timer.function = kbasep_reset_timeout;",
      "",
      "\thrtimer_start(&rtdata.timer, HR_TIMER_DELAY_MSEC(RESET_TIMEOUT),",
      "\t\t\t\t\t\t\tHRTIMER_MODE_REL);",
      "",
      "\t/* Wait for the RESET_COMPLETED interrupt to be raised */",
      "\tkbase_pm_wait_for_reset(kbdev);",
      "",
      "#if IS_ENABLED(CONFIG_MALI_MTK_TIMEOUT_RESET)",
      "\tif (!kbdev->reset_force_hard_reset) {",
      "#endif",
      "\tif (!rtdata.timed_out) {",
      "\t\t/* GPU has been reset */",
      "\t\thrtimer_cancel(&rtdata.timer);",
      "\t\tdestroy_hrtimer_on_stack(&rtdata.timer);",
      "\t\tdev_info(kbdev->dev, \"GPU soft reset completed\");",
      "#if IS_ENABLED(CONFIG_MALI_MTK_DEBUG)",
      "\t\tged_log_buf_print2(",
      "\t\t\tkbdev->ged_log_buf_hnd_kbase, GED_LOG_ATTR_TIME,",
      "\t\t\t\"GPU soft reset completed\\n\");",
      "#endif",
      "\t\treturn 0;"
    ]
  },
  {
    "path": "/home/lizi/IOS/work-xaga/k-xaga-16.2/drivers/gpu/mediatek/mali-valhall/gpu/arm/midgard/backend/gpu/mali_kbase_pm_driver.c",
