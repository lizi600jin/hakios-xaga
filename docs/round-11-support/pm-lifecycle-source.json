      "static int kbase_backend_late_init(struct kbase_device *kbdev)",
      "{",
      "\tint err;",
      "",
      "\terr = kbase_hwaccess_pm_init(kbdev);",
      "\tif (err)",
      "\t\treturn err;",
      "",
      "\terr = kbase_reset_gpu_init(kbdev);",
      "\tif (err)",
      "\t\tgoto fail_reset_gpu_init;",
      "",
      "\terr = kbase_hwaccess_pm_powerup(kbdev, PM_HW_ISSUES_DETECT);",
      "\tif (err)",
      "\t\tgoto fail_pm_powerup;",
      "",
      "\terr = kbase_backend_timer_init(kbdev);"
    ]
  },
