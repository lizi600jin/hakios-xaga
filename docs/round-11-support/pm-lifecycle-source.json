    "lines": [
      "void kbase_cache_set_coherency_mode(struct kbase_device *kbdev,",
      "\t\tu32 mode)",
      "{",
      "\tkbdev->current_gpu_coherency_mode = mode;",
      "",
      "\tif (kbase_hw_has_feature(kbdev, BASE_HW_FEATURE_COHERENCY_REG))",
      "\t\tkbase_reg_write(kbdev, COHERENCY_ENABLE, mode);",
      "}"
    ]
