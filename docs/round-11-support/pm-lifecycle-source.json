      "#ifndef PLATFORM_PROTECTED_CALLBACKS",
      "static int kbasep_protected_mode_enable(struct protected_mode_device *pdev)",
      "{",
      "\tstruct kbase_device *kbdev = pdev->data;",
      "",
      "\treturn kbase_pm_protected_mode_enable(kbdev);",
      "}",
      "",
      "static int kbasep_protected_mode_disable(struct protected_mode_device *pdev)",
      "{",
      "\tstruct kbase_device *kbdev = pdev->data;",
      "",
      "\treturn kbase_pm_protected_mode_disable(kbdev);",
      "}",
      "",
      "static const struct protected_mode_ops kbasep_native_protected_ops = {",
      "\t.protected_mode_enable = kbasep_protected_mode_enable,",
      "\t.protected_mode_disable = kbasep_protected_mode_disable",
      "};",
      "",
      "#define PLATFORM_PROTECTED_CALLBACKS (&kbasep_native_protected_ops)",
      "#endif /* PLATFORM_PROTECTED_CALLBACKS */",
      "",
      "int kbase_protected_mode_init(struct kbase_device *kbdev)",
      "{",
      "\t/* Use native protected ops */",
      "\tkbdev->protected_dev = kzalloc(sizeof(*kbdev->protected_dev),",
      "\t\t\tGFP_KERNEL);",
      "\tif (!kbdev->protected_dev)",
      "\t\treturn -ENOMEM;",
      "\tkbdev->protected_dev->data = kbdev;",
      "\tkbdev->protected_ops = PLATFORM_PROTECTED_CALLBACKS;",
      "\tINIT_WORK(&kbdev->protected_mode_hwcnt_disable_work,"
    ]
  }
