    "lines": [
      "int kbase_pm_protected_mode_disable(struct kbase_device *const kbdev)",
      "{",
      "\tlockdep_assert_held(&kbdev->pm.lock);",
      "",
      "#if IS_ENABLED(CONFIG_MALI_MTK_DEBUG)",
      "\tif (is_gpu_ged_log_enable())",
      "\t\tpr_info(\"[gpu_debug]%s\", __func__);",
      "#endif",
      "",
      "\treturn kbase_pm_do_reset(kbdev);",
      "}",
      "",
      "int kbase_pm_init_hw(struct kbase_device *kbdev, unsigned int flags)"
    ]
  },
  {
    "path": "/home/lizi/IOS/work-xaga/k-xaga-16.2/drivers/gpu/mediatek/mali-valhall/gpu/arm/midgard/backend/gpu/mali_kbase_pm_driver.c",
    "sha256": "a67a7c7c674eec23a61fee8abdef1818248a4f95ccedef1c5ef2eeed38c2e312",
    "start": 2892,
    "end": 2940,
    "lines": [
      "\t/* Ensure interrupts are off to begin with, this also clears any",
      "\t * outstanding interrupts",
      "\t */",
      "\tkbase_pm_disable_interrupts(kbdev);",
      "\t/* Ensure cache snoops are disabled before reset. */",
      "\tkbase_pm_cache_snoop_disable(kbdev);",
      "\t/* Prepare for the soft-reset */",
      "\tkbdev->pm.backend.reset_done = false;",
      "",
      "\t/* The cores should be made unavailable due to the reset */",
      "\tspin_lock_irqsave(&kbdev->hwaccess_lock, irq_flags);",
      "\tif (kbdev->pm.backend.shaders_state != KBASE_SHADERS_OFF_CORESTACK_OFF)",
      "\t\tKBASE_KTRACE_ADD(kbdev, PM_CORES_CHANGE_AVAILABLE, NULL, 0u);",
      "\tspin_unlock_irqrestore(&kbdev->hwaccess_lock, irq_flags);",
      "",
      "\t/* Soft reset the GPU */",
      "#ifdef CONFIG_MALI_ARBITER_SUPPORT",
      "\tif (!(flags & PM_NO_RESET))",
      "#endif /* CONFIG_MALI_ARBITER_SUPPORT */",
      "\t\terr = kbdev->protected_ops->protected_mode_disable(",
      "\t\t\t\tkbdev->protected_dev);",
      "",
      "\tspin_lock_irqsave(&kbdev->hwaccess_lock, irq_flags);",
      "#if MALI_USE_CSF",
      "\tif (kbdev->protected_mode) {",
      "\t\tunsigned long flags;",
      "",
      "\t\tkbase_ipa_control_protm_exited(kbdev);",
      "",
      "\t\tkbase_csf_scheduler_spin_lock(kbdev, &flags);",
      "\t\tkbase_hwcnt_backend_csf_protm_exited(&kbdev->hwcnt_gpu_iface);",
      "\t\tkbase_csf_scheduler_spin_unlock(kbdev, flags);",
      "\t}",
      "#endif",
      "\tkbdev->protected_mode = false;",
      "\tspin_unlock_irqrestore(&kbdev->hwaccess_lock, irq_flags);",
      "",
      "\tif (err)",
      "\t\tgoto exit;",
      "",
      "\tif (flags & PM_HW_ISSUES_DETECT) {",
      "\t\terr = kbase_pm_hw_issues_detect(kbdev);",
      "\t\tif (err)",
      "\t\t\tgoto exit;",
      "\t}",
      "",
      "\tkbase_pm_hw_issues_apply(kbdev);",
      "\tkbase_cache_set_coherency_mode(kbdev, kbdev->system_coherency);",
      ""
    ]
  },
  {
    "path": "/home/lizi/IOS/work-xaga/k-xaga-16.2/drivers/gpu/mediatek/mali-valhall/gpu/arm/midgard/backend/gpu/mali_kbase_cache_policy_backend.c",
