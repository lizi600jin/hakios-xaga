    "lines": [
      "static u64 example_mgm_update_gpu_pte(",
      "\tstruct memory_group_manager_device *const mgm_dev, int const group_id,",
      "\tint const mmu_level, u64 pte)",
      "{",
      "\tstruct mgm_groups *const data = mgm_dev->data;",
      "\tconst u32 pbha_bit_pos = 59; /* bits 62:59 */",
      "\tconst u32 pbha_bit_mask = 0xf; /* 4-bit */",
      "\tint default_group_id = data->default_group_id != 0?data->default_group_id:6;",
      "",
      "\tdev_vdbg(data->dev,",
      "\t\t\"%s(mgm_dev=%p, group_id=%d, mmu_level=%d, pte=0x%llx)\\n\",",
      "\t\t__func__, (void *)mgm_dev, default_group_id, mmu_level, pte);",
      "",
      "\tif (WARN_ON(default_group_id < 0) ||",
      "\t\tWARN_ON(default_group_id >= MEMORY_GROUP_MANAGER_NR_GROUPS))",
      "\t\treturn pte;",
      "",
      "\tpte |= ((u64)default_group_id & pbha_bit_mask) << pbha_bit_pos;",
      "",
      "\tdata->groups[default_group_id].update_gpu_pte++;",
      "",
      "\treturn pte;"
    ]
  },
  {
    "path": "/home/lizi/IOS/work-xaga/k-xaga-16.2/drivers/gpu/mediatek/mali-valhall/gpu/arm/midgard/mmu/mali_kbase_mmu_mode_aarch64.c",
    "sha256": "b3cf619fae60ea26c537b56669ad8b6bd99e63b36c29bcc4b7f242260dbe4b5c",
    "start": 114,
    "end": 155,
    "lines": [
      "static u64 get_mmu_flags(unsigned long flags)",
      "{",
      "\tu64 mmu_flags;",
      "",
      "\t/* store mem_attr index as 4:2 (macro called ensures 3 bits already) */",
      "\tmmu_flags = KBASE_REG_MEMATTR_VALUE(flags) << 2;",
      "",
      "\t/* Set access flags - note that AArch64 stage 1 does not support",
      "\t * write-only access, so we use read/write instead",
      "\t */",
      "\tif (flags & KBASE_REG_GPU_WR)",
      "\t\tmmu_flags |= ENTRY_ACCESS_RW;",
      "\telse if (flags & KBASE_REG_GPU_RD)",
      "\t\tmmu_flags |= ENTRY_ACCESS_RO;",
      "",
      "\t/* nx if requested */",
      "\tmmu_flags |= (flags & KBASE_REG_GPU_NX) ? ENTRY_NX_BIT : 0;",
      "",
      "\tif (flags & KBASE_REG_SHARE_BOTH) {",
      "\t\t/* inner and outer shareable */",
      "\t\tmmu_flags |= SHARE_BOTH_BITS;",
      "\t} else if (flags & KBASE_REG_SHARE_IN) {",
      "\t\t/* inner shareable coherency */",
      "\t\tmmu_flags |= SHARE_INNER_BITS;",
      "\t}",
      "",
      "\treturn mmu_flags;",
      "}",
      "",
      "static void entry_set_ate(u64 *entry,",
      "\t\tstruct tagged_addr phy,",
      "\t\tunsigned long flags,",
      "\t\tint const level)",
      "{",
      "\tif (level == MIDGARD_MMU_BOTTOMLEVEL)",
      "\t\tpage_table_entry_set(entry, as_phys_addr_t(phy) |",
      "\t\t\t\tget_mmu_flags(flags) |",
      "\t\t\t\tENTRY_ACCESS_BIT | ENTRY_IS_ATE_L3);",
      "\telse",
      "\t\tpage_table_entry_set(entry, as_phys_addr_t(phy) |",
      "\t\t\t\tget_mmu_flags(flags) |",
      "\t\t\t\tENTRY_ACCESS_BIT | ENTRY_IS_ATE_L02);"
    ]
  }
]
