+/*
+ * How long the "SYSTEM IMAGE" page is held before the kernel is started. It exists so that a
+ * photograph can be taken of the three numbers that decide whether md0 is the 2.3 GiB system
+ * image or the 4 MB root. 0 -- no hold at all -- is what a build meant to be used wants: the
+ * same numbers still go to the logbook. Was a hard-coded 60000 ms, which cost every boot a
+ * minute of doing nothing.
+ */
+#ifndef XNU_SYSTEM_REPORT_HOLD_MS
+#define XNU_SYSTEM_REPORT_HOLD_MS   0u
+#endif
