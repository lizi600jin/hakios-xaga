+/*
+ * ---- EP2, the ECM data endpoint ----
+ *
+ * Trial801 configures the endpoint and its lifetime only; the packets themselves arrive in
+ * Trial802. Keeping the two apart means a failure here is unambiguously a register problem.
+ *
+ * The values are the ones in STAGE2-PLAN.md section 1, which came from mtu3.ko:mtu3_config_ep
+ * (0x7c78 / 0x7d20), not from the Linux driver -- the vendor module enables DMAREQEN and this
+ * path deliberately does not, because the plan is PIO until the endpoint is known to work.
+ */
+static bool ep2_ready;
+
+/* Trial802: the data path's buffers and counters, declared here because ep2_disable() clears them. */
+#define EP2_FRAME_MAX   1514u   /* the largest Ethernet frame, as in HAKIOS_NET_FRAME_MAX */
+static uint8_t ep2_rx_frame[EP2_FRAME_MAX];
+static uint32_t ep2_rx_len;
+static bool ep2_rx_overflow;
+static uint8_t ep2_tx_frame[EP2_FRAME_MAX];
+static uint32_t ep2_tx_len;
+static uint32_t ep2_tx_off;
+static bool ep2_tx_active;
+static bool ep2_tx_zlp;
+static uint32_t ep2_rx_packets;
+static uint32_t ep2_tx_packets;
+static uint32_t ep2_zlp_count;
+
+static bool
+ep2_qmu_left_active(void)
+{
+	uint32_t tx = mac_rd(U3D_TXQCSR2);
+	uint32_t rx = mac_rd(U3D_RXQCSR2);
+	bool busy = false;
+
+	/*
+	 * fastboot leaves the QMU running if it was using the endpoint. A queue that is still
+	 * active would fight PIO for the FIFO, so stop it and wait for the hardware to agree.
+	 */
+	if ((tx & QMU_ACTIVE) != 0u) {
+		mac_wr(U3D_TXQCSR2, QMU_STOP);
+		for (unsigned i = 0; i < 1000u; i++) {
+			if ((mac_rd(U3D_TXQCSR2) & QMU_ACTIVE) == 0u) break;
+			delay(1);
+		}
+		busy |= (mac_rd(U3D_TXQCSR2) & QMU_ACTIVE) != 0u;
+	}
+	if ((rx & QMU_ACTIVE) != 0u) {
+		mac_wr(U3D_RXQCSR2, QMU_STOP);
+		for (unsigned i = 0; i < 1000u; i++) {
+			if ((mac_rd(U3D_RXQCSR2) & QMU_ACTIVE) == 0u) break;
+			delay(1);
+		}
+		busy |= (mac_rd(U3D_RXQCSR2) & QMU_ACTIVE) != 0u;
+	}
+	return busy;
+}
+
+static void
+ep2_reset_pulse(void)
+{
+	/*
+	 * EP_RST is level-held, like EP0's: raise, wait, clear. Leaving it raised holds the
+	 * endpoint in reset and nothing ever arrives, which is exactly the trap EP0 fell into.
+	 */
+	mac_set(U3D_EP_RST, EP2_RST_BOTH);
+	delay(1);
+	mac_clear(U3D_EP_RST, EP2_RST_BOTH);
+}
+
+static void
+ep2_disable(void)
+{
+	if (!ep2_ready) {
+		return;
+	}
+	ep2_ready = false;
+
+	/* Trial802: a half-received frame and an in-flight transmission do not survive */
+	ep2_rx_len = 0;
+	ep2_rx_overflow = false;
+	ep2_tx_active = false;
+	ep2_tx_zlp = false;
+	ep2_tx_off = 0;
+
+	/* close the event sources first, then stop the endpoint, then reset it */
+	mac_wr(U3D_EPIECR, EP2_ISR_BOTH);
+	mac_clear(U3D_DEV_LINK_INTR_ENABLE, 0u);        /* nothing extra; kept for symmetry */
+
+	mac_wr(U3D_TX2CSR0, 0u);
+	mac_wr(U3D_TX2CSR1, 0u);
+	mac_wr(U3D_TX2CSR2, 0u);
+	mac_wr(U3D_RX2CSR0, 0u);
+	mac_wr(U3D_RX2CSR1, 0u);
+	mac_wr(U3D_RX2CSR2, 0u);
+
+	ep2_reset_pulse();
+	mac_wr(U3D_EPISR, EP2_ISR_BOTH);                /* drop anything latched */
+
+	printf("usb: ep2 disabled; tx2csr0 %#x rx2csr0 %#x episr %#x epier %#x\n",
+	    mac_rd(U3D_TX2CSR0), mac_rd(U3D_RX2CSR0),
+	    mac_rd(U3D_EPISR) & EP2_ISR_BOTH, mac_rd(U3D_EPIER) & EP2_ISR_BOTH);
+}
+
+/* ---- Trial802: the PIO data path ---- */
+
+/*
+ * Everything here runs on the USB thread and is the only thing that touches these registers.
+ * The host side of the test is a bulk loopback: whatever it writes to 0x02 comes back on 0x82.
+ */
+
+#define EP2_MPS         512u
+
+static void
+ep2_fifo_write(const uint8_t *src, uint32_t length)
+{
+	vm_offset_t fifo = usb_mac + U3D_FIFO2;
+	const uint8_t *in = src;
+
+	/* same split as EP0: the FIFO counts bytes per access, so the tail uses narrower writes */
+	while (length >= 4u) {
+		uint32_t value = (uint32_t)in[0] | ((uint32_t)in[1] << 8) |
+		    ((uint32_t)in[2] << 16) | ((uint32_t)in[3] << 24);
+
+		*(volatile uint32_t *)fifo = value;
+		in += 4;
+		length -= 4;
+	}
+	if ((length & 2u) != 0u) {
+		*(volatile uint16_t *)fifo = (uint16_t)in[0] | ((uint16_t)in[1] << 8);
+		in += 2;
+	}
+	if ((length & 1u) != 0u) {
+		*(volatile uint8_t *)fifo = in[0];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+ep2_fifo_read(uint8_t *dst, uint32_t length)
+{
+	vm_offset_t fifo = usb_mac + U3D_FIFO2;
+	uint8_t *out = dst;
+
+	/*
+	 * The plan's rule: read whole words while they are there, and for a tail of one to three
+	 * bytes read one more word and keep only the bytes wanted. Reading a byte at a time would
+	 * desynchronise the FIFO.
+	 */
+	while (length >= 4u) {
+		uint32_t value = *(volatile uint32_t *)fifo;
+
+		out[0] = (uint8_t)(value & 0xff);
+		out[1] = (uint8_t)((value >> 8) & 0xff);
+		out[2] = (uint8_t)((value >> 16) & 0xff);
+		out[3] = (uint8_t)((value >> 24) & 0xff);
+		out += 4;
+		length -= 4;
+	}
+	if (length != 0u) {
+		uint32_t value = *(volatile uint32_t *)fifo;
+
+		for (uint32_t i = 0; i < length; i++) {
+			out[i] = (uint8_t)((value >> (8 * i)) & 0xff);
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * Take every packet the endpoint has ready. A packet shorter than the maximum packet size ends
+ * the frame; an exact multiple is ended by a zero-length packet, which is why the host sends one.
+ */
+static void
+ep2_out_service(void)
+{
+	for (unsigned round = 0; round < 8u; round++) {
+		uint32_t csr = mac_rd(U3D_RX2CSR0);
+		uint32_t count;
+		uint32_t take;
+
+		if ((csr & EP_RXPKTRDY) == 0u) {
+			break;
+		}
+		count = (mac_rd(U3D_RX2CSR3) >> 16) & 0xffffu;
+
+		/* Trial802b: every packet the endpoint hands over, so a short frame is visible */
+		printf("usb: ep2 out pkt len %u csr %#x rx3 %#x have %u\n",
+		    count, csr, mac_rd(U3D_RX2CSR3), ep2_rx_len);
+
+		if (count > EP2_MPS) {
+			printf("usb: ep2 out bad count %u csr %#x; resetting the endpoint\n", count, csr);
+			ep2_reset_pulse();
+			mac_wr(U3D_EPISR, EP2_ISR_BOTH);
+			mac_wr(U3D_EPIESR, EP2_ISR_BOTH);
+			ep2_rx_len = 0;
+			ep2_rx_overflow = false;
+			break;
+		}
+
+		take = count;
+		if (ep2_rx_len + take > EP2_FRAME_MAX) {
+			if (!ep2_rx_overflow) {
+				printf("usb: ep2 out frame over %u bytes; dropping\n", EP2_FRAME_MAX);
+			}
+			ep2_rx_overflow = true;
+			take = 0;
+		} else if (take != 0u) {
+			ep2_fifo_read(ep2_rx_frame + ep2_rx_len, take);
+			ep2_rx_len += take;
+		}
+		ep2_rx_packets++;
+
+		/* release the packet: acknowledge the FIFO and let the next slot open */
+		mac_wr(U3D_RX2CSR0, (csr & EP_RX_CSR_KEEP) | EP_RXPKTRDY);
+		mac_wr(U3D_EPISR, EP_ISR_RX(2));
+
+		if (count < EP2_MPS) {
+			if (ep2_rx_overflow) {
+				ep2_rx_overflow = false;
+			} else if (ep2_rx_len != 0u) {
+				printf("usb: ep2 out frame %u bytes\n", ep2_rx_len);
+				/* Trial802 loopback: hand the bytes straight back to the host */
+				if (ep2_rx_len <= sizeof(ep2_tx_frame) && !ep2_tx_active) {
+					for (uint32_t i = 0; i < ep2_rx_len; i++) {
+						ep2_tx_frame[i] = ep2_rx_frame[i];
+					}
+					ep2_tx_len = ep2_rx_len;
+					ep2_tx_off = 0;
+					ep2_tx_active = true;
+					ep2_tx_zlp = (ep2_rx_len % EP2_MPS) == 0u;
+				}
+			}
+			ep2_rx_len = 0;
+		}
+	}
+}
+
+/* Send at most one packet per call, so EP0 keeps getting served while a frame is in flight. */
+static void
+ep2_in_service(void)
+{
+	uint32_t csr;
+	uint32_t chunk;
+	uint32_t epi;
+
+	if (!ep2_tx_active) {
+		return;
+	}
+	csr = mac_rd(U3D_TX2CSR0);
+	if ((csr & (EP_TXPKTRDY | EP_TX_FIFOFULL)) != 0u) {
+		return;         /* the previous packet has not gone yet */
+	}
+
+	/*
+	 * Trial802b: one state machine, two kinds of packet.
+	 *
+	 * The 512-byte case stalled because the zero-length packet that ends an exact-multiple
+	 * frame was never submitted: the old code cleared the "owe a ZLP" flag as soon as the
+	 * last data packet went out, and the next call then saw nothing left to send and an
+	 * empty flag, and finished the transfer. The host, still waiting for the packet that
+	 * marks the end of the frame, timed out.
+	 *
+	 * Now the flag means "a zero-length packet is still owed", and it is only cleared when
+	 * that packet has actually been submitted.
+	 */
+	chunk = ep2_tx_len - ep2_tx_off;
+	if (chunk > EP2_MPS) {
+		chunk = EP2_MPS;
+	}
+
+	if (chunk != 0u) {
+		ep2_fifo_write(ep2_tx_frame + ep2_tx_off, chunk);
+	} else if (ep2_tx_zlp) {
+		ep2_tx_zlp = false;             /* this submission is the zero-length packet */
+		ep2_zlp_count++;
+	} else {
+		ep2_tx_active = false;          /* everything, including any ZLP, has gone */
+		return;
+	}
+
+	/* drop a stale completion before submitting, the same way the EP0 path does */
+	epi = mac_rd(U3D_EPISR);
+	if ((epi & EP_ISR_TX(2)) != 0u) {
+		mac_wr(U3D_EPISR, EP_ISR_TX(2));
+	}
+	mac_wr(U3D_TX2CSR0, (csr & EP_TX_CSR_KEEP) | EP_TXPKTRDY);
+
+	ep2_tx_off += chunk;
+	ep2_tx_packets++;
+
+	/*
+	 * The transfer ends here only when the last data packet has gone and no zero-length
+	 * packet is owed; otherwise it stays active so the next call can finish the job.
+	 */
+	if (chunk != 0u && ep2_tx_off >= ep2_tx_len && !ep2_tx_zlp) {
+		ep2_tx_active = false;
+	}
+}
+
+static void
+ep2_service(void)
+{
+	if (!ep2_ready) {
+		return;
+	}
+	ep2_out_service();
+	ep2_in_service();
+}
+
+static bool
+ep2_enable(void)
+{
+	uint32_t tx0, rx0, tx1, rx1, tx2, rx2;
+
+	if (ep2_qmu_left_active()) {
+		printf("usb: ep2 enable refused, a QMU queue is still active "
+		    "(txqcsr2 %#x rxqcsr2 %#x)\n",
+		    mac_rd(U3D_TXQCSR2), mac_rd(U3D_RXQCSR2));
+		return false;
+	}
+
+	/* Start from a known state: no events, endpoint held in reset, then released. */
+	mac_wr(U3D_EPIECR, EP2_ISR_BOTH);
+	mac_wr(U3D_EPISR, EP2_ISR_BOTH);
+	ep2_reset_pulse();
+
+	/*
+	 * CSR0: max packet 512, and DMAREQEN (bit 29) left clear so the endpoint works from the
+	 * CPU through the FIFO. CSR1: type 0 is bulk, slot 0. CSR2: segsize 9 is 512 bytes, and the
+	 * FIFO address is a byte address shifted right four bits.
+	 */
