-/* Trial725 only. No UFS access is allowed on return before this guard. */
+/* Trial726 only. No UFS access is allowed on return before this guard. */
 static void ufs_read_guard_barrier(void *unused)
 {
     (void)unused;
@@ -2509,7 +2509,7 @@ static void ufs_read_guard_start(void)
