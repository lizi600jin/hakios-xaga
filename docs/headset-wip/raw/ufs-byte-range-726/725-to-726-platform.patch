diff --git a/source/ufs_twoblock/codec/ufs_byte_range_codec.h b/source/ufs_twoblock/codec/ufs_byte_range_codec.h
new file mode 100644
index 0000000..b8e794a
--- /dev/null
+++ b/source/ufs_twoblock/codec/ufs_byte_range_codec.h
@@ -0,0 +1,102 @@
+#ifndef MT6895_UFS_BYTE_RANGE_CODEC_H
+#define MT6895_UFS_BYTE_RANGE_CODEC_H
+
+/* Trial726: map a byte range onto one or two whole 4096-byte blocks.
+ *
+ * The caller asks for bytes, the controller only moves whole blocks. This header decides which
+ * blocks cover the request, refuses anything unbounded, and says which slice of the delivered
+ * bytes the caller actually asked for.
+ */
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "ufs_two_block_codec.h"
+#include "../../ufs_varread/metadata/ufs_varread_reference.h"
+
+#define VRB_BLOCK_BYTES   VR_BLOCK_BYTES
+#define VRB_MAX_BLOCKS    2u
+#define VRB_WINDOW_BYTES  (VRB_MAX_BLOCKS * VRB_BLOCK_BYTES)
+
+/* Where a byte range lands, once it has been accepted. */
+struct vrb_window {
+    uint32_t first_lba;        /* LBA of the first covering block */
+    uint32_t blocks;           /* 1 or 2 */
+    uint32_t in_block_offset;  /* offset of the first requested byte inside that block */
+    uint32_t first_bytes;      /* bytes taken from the first block */
+    uint32_t second_bytes;     /* bytes taken from the second block, 0 when blocks == 1 */
+};
+
+/* Reasons a range is refused. Kept explicit so a test can name the path. */
+enum vrb_reject {
+    VRB_OK = 0,
+    VRB_ERR_NULL,          /* argument pointer was NULL */
+    VRB_ERR_ZERO_LENGTH,   /* length == 0 */
+    VRB_ERR_OVERFLOW,      /* offset + length does not fit in the address space */
+    VRB_ERR_TOO_LONG,      /* the range spans more than two blocks */
+    VRB_ERR_OUT_TOO_SMALL, /* the caller's buffer cannot hold the range */
+    VRB_ERR_NO_REFERENCE,  /* a covering LBA has no frozen reference */
+    VRB_ERR_LBA_RANGE      /* a covering LBA is outside the runtime geometry */
+};
+
+/* Refuse before any command is built. Pure arithmetic plus the frozen reference table. */
+static inline enum vrb_reject
+vrb_plan(uint32_t byte_offset, uint32_t byte_length, uint32_t out_capacity,
+    const struct vr_limits *limits, struct vrb_window *out)
+{
+    if (!limits || !out) return VRB_ERR_NULL;
+
+    /* Zero first: a zero-length request covering nothing must not be turned into a block read. */
+    if (byte_length == 0u) return VRB_ERR_ZERO_LENGTH;
+
+    /* Check the sum before dividing, so a wrapped offset cannot look in-range. */
+    if (byte_offset > UINT32_MAX - byte_length) return VRB_ERR_OVERFLOW;
+
+    /* The caller must be able to hold exactly what it asked for. */
+    if (out_capacity < byte_length) return VRB_ERR_OUT_TOO_SMALL;
+
+    const uint32_t first_lba   = byte_offset / VRB_BLOCK_BYTES;
+    const uint32_t in_offset   = byte_offset % VRB_BLOCK_BYTES;
+    const uint32_t first_bytes = (byte_length < VRB_BLOCK_BYTES - in_offset)
+        ? byte_length
+        : VRB_BLOCK_BYTES - in_offset;
+    const uint32_t second_bytes = byte_length - first_bytes;
+    const uint32_t blocks = (second_bytes > 0u) ? 2u : 1u;
+
+    if (blocks > VRB_MAX_BLOCKS) return VRB_ERR_TOO_LONG;
+    if (second_bytes > VRB_BLOCK_BYTES) return VRB_ERR_TOO_LONG;
+
+    /* Geometry: every covering block must be inside the runtime limit and have a reference. */
+    if (first_lba > limits->lba_max_exclusive ||
+        limits->lba_max_exclusive - first_lba < blocks) {
+        return VRB_ERR_LBA_RANGE;
+    }
+    for (uint32_t b = 0; b < blocks; ++b) {
+        if (!varread_reference_is_known(first_lba + b)) return VRB_ERR_NO_REFERENCE;
+    }
+
+    out->first_lba       = first_lba;
+    out->blocks          = blocks;
+    out->in_block_offset = in_offset;
+    out->first_bytes     = first_bytes;
+    out->second_bytes    = second_bytes;
+    return VRB_OK;
+}
+
+/* Copy only the requested bytes out of the verified block image. */
+static inline bool
+vrb_deliver(const uint8_t *verified, const struct vrb_window *w, uint8_t *dst, uint32_t dst_bytes)
+{
+    if (!verified || !w || !dst) return false;
+    if (dst_bytes < w->first_bytes + w->second_bytes) return false;
+    uint32_t at = 0;
+    for (uint32_t i = 0; i < w->first_bytes; ++i)
+        dst[at++] = verified[w->in_block_offset + i];
+    if (w->second_bytes) {
+        const uint8_t *second = verified + VRB_BLOCK_BYTES;
+        for (uint32_t i = 0; i < w->second_bytes; ++i)
+            dst[at++] = second[i];
+    }
+    return at == w->first_bytes + w->second_bytes;
+}
+
+#endif
