diff --git a/tests/test-byte-range-codec.c b/tests/test-byte-range-codec.c
new file mode 100644
index 0000000..0cf002a
--- /dev/null
+++ b/tests/test-byte-range-codec.c
@@ -0,0 +1,113 @@
+/* Host test for the Trial726 byte-range planner and delivery.
+ *
+ * Every refusal is checked both for its reason and for the fact that no window was produced, so a
+ * rejected range cannot be mistaken for an accepted one.
+ */
+#define _GNU_SOURCE
+#define US_HOST_TEST 1
+
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "ufs_byte_range_codec.h"
+
+static unsigned failures;
+
+static void
+ok(const char *name, bool cond)
+{
+    printf("  %-46s %s\n", name, cond ? "PASS" : "FAIL");
+    if (!cond) failures++;
+}
+
+static enum vrb_reject
+plan(uint32_t off, uint32_t len, uint32_t cap, struct vrb_window *w, const struct vr_limits *lim)
+{
+    struct vrb_window scratch;
+    memset(&scratch, 0xA5, sizeof(scratch));
+    enum vrb_reject r = vrb_plan(off, len, cap, lim, &scratch);
+    if (r == VRB_OK) { if (w) *w = scratch; }
+    else if (w) { *w = scratch; }
+    return r;
+}
+
+int main(void)
+{
+    const struct vr_limits lim = vr_runtime_limits();
+    struct vrb_window w;
+
+    puts("Trial726 byte-range planner");
+
+    /* --- the designated device case --- */
+    memset(&w, 0, sizeof(w));
+    enum vrb_reject r = plan(12031u, 770u, 770u, &w, &lim);
+    ok("offset 12031 len 770 accepted", r == VRB_OK);
+    ok("  first_lba == 2", w.first_lba == 2u);
+    ok("  blocks == 2", w.blocks == 2u);
+    ok("  in_block_offset == 3839", w.in_block_offset == 3839u);
+    ok("  first_bytes == 257", w.first_bytes == 257u);
+    ok("  second_bytes == 513", w.second_bytes == 513u);
+
+    /* --- single block boundary cases --- */
+    r = plan(8192u, 4096u, 4096u, &w, &lim);
+    ok("whole block at LBA2 -> 1 block", r == VRB_OK && w.blocks == 1u &&
+        w.first_bytes == 4096u && w.second_bytes == 0u);
+    r = plan(8192u, 1u, 1u, &w, &lim);
+    ok("one byte at LBA2 start -> 1 block", r == VRB_OK && w.blocks == 1u);
+    r = plan(8192u + 4095u, 1u, 1u, &w, &lim);
+    ok("last byte of LBA2 -> 1 block, offset 4095", r == VRB_OK && w.blocks == 1u &&
+        w.in_block_offset == 4095u);
+    r = plan(8192u + 4095u, 2u, 2u, &w, &lim);
+    ok("straddle by one byte -> 2 blocks", r == VRB_OK && w.blocks == 2u &&
+        w.first_bytes == 1u && w.second_bytes == 1u);
+
+    /* --- refusals: each must leave no usable window --- */
+    r = plan(12031u, 0u, 770u, &w, &lim);
+    ok("zero length refused", r == VRB_ERR_ZERO_LENGTH);
+    r = plan(12031u, 770u, 769u, &w, &lim);
+    ok("output too small refused", r == VRB_ERR_OUT_TOO_SMALL);
+    r = plan(0xFFFFFFF0u, 0x20u, 0x20u, &w, &lim);
+    ok("offset+length overflow refused", r == VRB_ERR_OVERFLOW);
+    r = plan(8192u, 4096u * 2u + 1u, 4096u * 2u + 1u, &w, &lim);
+    ok("more than two blocks refused", r == VRB_ERR_TOO_LONG);
+    r = plan(8192u, 4096u * 3u, 4096u * 3u, &w, &lim);
+    ok("exactly three blocks refused", r == VRB_ERR_TOO_LONG);
+    r = plan(8192u * 20u, 10u, 10u, &w, &lim);
+    ok("beyond geometry refused", r == VRB_ERR_LBA_RANGE);
+    r = vrb_plan(12031u, 770u, 770u, NULL, &w) == VRB_ERR_NULL ? VRB_ERR_NULL : VRB_OK;
+    ok("null limits refused", r == VRB_ERR_NULL);
+    r = vrb_plan(12031u, 770u, 770u, &lim, NULL) == VRB_ERR_NULL ? VRB_ERR_NULL : VRB_OK;
+    ok("null window refused", r == VRB_ERR_NULL);
+    /* offsets 0..3 map to LBA 0, which has no frozen reference in the 723+ table */
+    r = plan(0u, 10u, 10u, &w, &lim);
+    ok("LBA0 without reference refused", r == VRB_ERR_NO_REFERENCE);
+
+    /* --- delivery copies exactly the requested bytes --- */
+    {
+        uint8_t blocks[2 * VRB_BLOCK_BYTES];
+        for (unsigned i = 0; i < sizeof(blocks); ++i) blocks[i] = (uint8_t)(i * 7u + 3u);
+        uint8_t out[770 + 2];
+        out[0] = 0x5A; out[771] = 0x5A;               /* sentinels either side */
+        memset(&w, 0, sizeof(w));
+        r = plan(12031u, 770u, 770u, &w, &lim);
+        bool copied = vrb_deliver(blocks, &w, out + 1, 770u);
+        ok("delivery succeeded", r == VRB_OK && copied);
+        ok("  first byte from block0[3839]", out[1] == blocks[3839]);
+        ok("  byte 257 from block1[0]", out[1 + 257] == blocks[4096]);
+        ok("  last byte from block1[512]", out[1 + 769] == blocks[4096 + 512]);
+        ok("  sentinel before unchanged", out[0] == 0x5A);
+        ok("  sentinel after unchanged", out[771] == 0x5A);
+        bool whole = true;
+        for (unsigned i = 0; i < 257; ++i)
+            if (out[1 + i] != blocks[3839 + i]) whole = false;
+        for (unsigned i = 0; i < 513; ++i)
+            if (out[1 + 257 + i] != blocks[4096 + i]) whole = false;
+        ok("  all 770 bytes byte-for-byte", whole);
+        ok("delivery into too-small buffer refused",
+           !vrb_deliver(blocks, &w, out + 1, 769u));
+    }
+
+    printf("%s %u failure(s)\n", failures ? "FAILED" : "PASS", failures);
+    return failures ? 1 : 0;
+}
diff --git a/tests/test-byte-range-sweep.c b/tests/test-byte-range-sweep.c
new file mode 100644
index 0000000..51774d5
--- /dev/null
+++ b/tests/test-byte-range-sweep.c
@@ -0,0 +1,82 @@
+/* Exhaustive-ish sweep: every accepted window must satisfy the invariants the device path relies
+ * on, and nothing may be accepted that the caller could not hold or the controller could not read.
+ */
+#define _GNU_SOURCE
+#define US_HOST_TEST 1
+
+#include <stdio.h>
+#include <string.h>
+
+#include "ufs_byte_range_codec.h"
+
+static unsigned failures;
+
+static void
+bad(const char *what, uint32_t off, uint32_t len, uint64_t extra)
+{
+    if (failures < 12)
+        printf("  FAIL %s off=%u len=%u (%llu)\n", what, off, len,
+            (unsigned long long)extra);
+    failures++;
+}
+
+int main(void)
+{
+    const struct vr_limits lim = vr_runtime_limits();
+    struct vrb_window w;
+    uint64_t checked = 0, accepted = 0, refused = 0;
+
+    const uint32_t offsets[] = {
+        0u, 1u, 3839u, 4095u, 4096u, 8191u, 8192u, 12031u, 12287u, 12288u,
+        16383u, 16384u, 32767u, 32768u, 65535u, 65536u,
+        0x7FFFFFFFu, 0xFFFFF000u, 0xFFFFFFF0u, 0xFFFFFFFEu, 0xFFFFFFFFu,
+    };
+    const uint32_t lengths[] = {
+        0u, 1u, 2u, 769u, 770u, 257u, 513u, 4095u, 4096u, 4097u,
+        8191u, 8192u, 8193u, 0x7FFFFFFFu, 0xFFFFFFFFu,
+    };
+
+    for (size_t i = 0; i < sizeof(offsets) / sizeof(offsets[0]); ++i) {
+        for (size_t j = 0; j < sizeof(lengths) / sizeof(lengths[0]); ++j) {
+            const uint32_t off = offsets[i], len = lengths[j];
+            /* capacity given exactly, so only the range itself can be at fault */
+            enum vrb_reject r = vrb_plan(off, len, len, &lim, &w);
+            ++checked;
+            if (r == VRB_OK) {
+                ++accepted;
+                if (w.blocks < 1u || w.blocks > 2u) bad("blocks out of 1..2", off, len, w.blocks);
+                if (w.first_bytes + w.second_bytes != len)
+                    bad("segments do not sum to length", off, len,
+                        (uint64_t)w.first_bytes + w.second_bytes);
+                if (w.first_bytes == 0u || w.first_bytes > 4096u)
+                    bad("first segment size", off, len, w.first_bytes);
+                if (w.second_bytes > 4096u) bad("second segment size", off, len, w.second_bytes);
+                if (w.in_block_offset + w.first_bytes > 4096u)
+                    bad("first segment runs past block", off, len,
+                        (uint64_t)w.in_block_offset + w.first_bytes);
+                if (w.first_lba + w.blocks - 1u >= lim.lba_max_exclusive)
+                    bad("window past geometry", off, len, w.first_lba);
+                if (off + (uint64_t)len > (uint64_t)lim.lba_max_exclusive * 4096u)
+                    bad("range past geometry but accepted", off, len, 0);
+            } else {
+                ++refused;
+                if (len != 0u && off + (uint64_t)len <= (uint64_t)UINT32_MAX &&
+                    r == VRB_ERR_OVERFLOW)
+                    bad("overflow claimed without overflow", off, len, 0);
+            }
+        }
+    }
+
+    /* A range the caller cannot hold must never be accepted, whatever it covers. */
+    for (uint32_t len = 1; len <= 4200u; len += 137u) {
+        if (vrb_plan(12031u, len, len - 1u, &lim, &w) == VRB_OK)
+            bad("accepted with capacity below length", 12031u, len, 0);
+        ++checked;
+    }
+
+    printf("  combos %llu  accepted %llu  refused %llu  failures %u\n",
+        (unsigned long long)checked, (unsigned long long)accepted,
+        (unsigned long long)refused, failures);
+    printf("%s\n", failures ? "FAILED" : "PASS");
+    return failures ? 1 : 0;
+}
