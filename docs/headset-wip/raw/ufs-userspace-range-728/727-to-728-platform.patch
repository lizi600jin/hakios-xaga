diff --git a/tests/test-user-range-client.c b/tests/test-user-range-client.c
new file mode 100644
index 0000000..f92111a
--- /dev/null
+++ b/tests/test-user-range-client.c
@@ -0,0 +1,73 @@
+/* Run the shipped user program on the host with deterministic syscall results. */
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+int range_client(int, char **, char **);
+int range_errno;
+enum fault { CLEAN, WRITE_ALLOWED, OPEN_FAILED, SHORT_READ, WRONG_DATA, OVERWROTE_GUARD, BAD_EOF, REPEAT_ALLOWED, CLOSE_FAILED };
+static enum fault fault;
+static uint8_t reference[770];
+static unsigned reads;
+static int opens, closes;
+
+int range_pid(void) { return 42; }
+int range_open(const char *path, int flags, int mode)
+{
+	assert(strcmp(path, "/dev/mt6895-ufs-range") == 0 && mode == 0);
+	++opens;
+	if (flags == 1) {
+		range_errno = 30;
+		return fault == WRITE_ALLOWED ? 7 : -1;
+	}
+	assert(flags == 0);
+	range_errno = 6;
+	return fault == OPEN_FAILED ? -1 : 7;
+}
+
+long range_pread(int fd, void *dst, size_t n, long long off)
+{
+	assert(fd == 7);
+	if (reads++ == 0) {
+		assert(off == 12031 && n == sizeof(reference));
+		memcpy(dst, reference, n);
+		uint8_t *bytes = dst;
+		if (fault == WRONG_DATA) bytes[0] ^= 1;
+		if (fault == OVERWROTE_GUARD) bytes[n] = 0;
+		return fault == SHORT_READ ? (long)n - 1 : (long)n;
+	}
+	if (reads == 2) {
+		assert(off == 65536 && n == 1);
+		return fault == BAD_EOF ? 1 : 0;
+	}
+	assert(reads == 3 && off == 12031 && n == sizeof(reference));
+	range_errno = 16;
+	return fault == REPEAT_ALLOWED ? (long)n : -1;
+}
+
+int range_close(int fd)
+{
+	assert(fd == 7);
+	closes++;
+	return fault == CLOSE_FAILED ? -1 : 0;
+}
+
+int main(int argc, char **argv)
+{
+	assert(argc == 2);
+	FILE *f = fopen(argv[1], "rb");
+	assert(f && fseek(f, 12031, SEEK_SET) == 0 && fread(reference, 1, sizeof(reference), f) == sizeof(reference));
+	assert(fclose(f) == 0);
+	for (int i = CLEAN; i <= CLOSE_FAILED; ++i) {
+		fault = (enum fault)i;
+		opens = closes = 0;
+		reads = 0;
+		int rc = range_client(0, NULL, NULL);
+		assert((rc == 0) == (fault == CLEAN));
+		assert(opens >= 1 && closes == (fault == OPEN_FAILED ? 0 : 1));
+		if (fault == CLEAN) assert(reads == 3);
+	}
+	puts("Trial728 user client: success accepted; eight faulty syscall cases rejected");
+	return 0;
+}
