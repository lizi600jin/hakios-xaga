+static void test_request_lengths(void)
+{
+    const uint8_t zeros[VR_BLOCK_BYTES] = {0};
+    /* Python zlib.crc32 of the model payload ending at LBA 15. */
+    const uint32_t tail_crc[] = {0xeb5d061du, 0xf1647394u};
+    const struct vr_limits rt = vr_runtime_limits();
+    struct memory_snapshot before;
+    unsigned combinations = 0;
+
+    SCENARIO("all 31 permitted LBA and length combinations with guarded data callbacks");
+    for (uint32_t blocks = 1; blocks <= 2; blocks++) {
+        const uint32_t words = blocks * VRQ_BLOCK_WORDS;
+        const uint32_t bytes = blocks * VR_BLOCK_BYTES;
+        for (uint32_t lba = 0; lba <= rt.lba_max_exclusive - blocks; lba++) {
+            const bool tail = lba == rt.lba_max_exclusive - blocks;
+            struct vr_request r = {VR_LUN, lba, blocks, VR_BLOCK_BYTES};
+            struct vrq_io io = make_io();
+            model_reset();
+            M.accessible_words = words;
+            snapshot(&before);
+            memset(OUT.data, 0x55, sizeof(OUT.data));
+            vrq_run(&io, &r, &rt, &WS, &OUT, &CTR, tail, tail_crc[blocks - 1]);
+            CHECK(OUT.result == VRQ_DELIVERED && OUT.data_complete);
+            CHECK(CTR.ring == 1 && M.saw_command && M.decoded_opcode == 0x28u);
+            CHECK(M.decoded_lba == lba && M.decoded_blocks == blocks);
+            CHECK(OUT.lba == lba && OUT.blocks == blocks && OUT.block_bytes == VR_BLOCK_BYTES);
+            CHECK(OUT.data_words_valid == words && OUT.data_words_attempted == words);
+            CHECK(OUT.restored && OUT.readback_restored && M.restore_data_writes == words);
+            CHECK(memcmp(OUT.data, M.answered, bytes) == 0);
+            if (blocks == 1)
+                CHECK(memcmp(OUT.data + bytes, zeros, sizeof(zeros)) == 0);
+            if (tail) {
+                CHECK(OUT.data_crc32 == tail_crc[blocks - 1]);
+                CHECK(OUT.data_match == VRQ_DATA_SAME_CHECKSUM);
+            }
+            check_restored(&before);
+            combinations++;
+        }
+    }
+    CHECK(combinations == 31);
+}
