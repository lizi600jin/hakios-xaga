+	case DKIOCGETMAXSEGMENTBYTECOUNTWRITE:
+	case DKIOCGETMAXBYTECOUNTREAD:
+	case DKIOCGETMAXBYTECOUNTWRITE: {
+		uint64_t max_bytes = (uint64_t)hakios_mt6895_ufs_write_max_blocks() * XNUSYS_BLOCK;
+		if (max_bytes < XNUSYS_BLOCK) max_bytes = XNUSYS_BLOCK;
+		*(uint64_t *)data = max_bytes;
+		return 0;
+	}
+	case DKIOCSYNCHRONIZE:
+	case DKIOCSYNCHRONIZECACHE: {
+		int err = 0;
+		if (xnusys_lock == NULL) return ENXIO;
