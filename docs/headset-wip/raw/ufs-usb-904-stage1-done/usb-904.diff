+/*
+ * Walk the message buffer and produce the byte at `position`, with position 0 being the oldest
+ * character still held. The buffer is a ring: msg_bufx is where the next character goes and
+ * msg_size is how big it is, so the logical order starts at msg_bufx and wraps.
+ *
+ * The text is copied out under the same lock printf() uses, one chunk at a time, rather than
+ * taking a snapshot of the whole ring: the ring is up to a quarter of a megabyte and this runs
+ * for every read the host asks for.
+ */
+static uint32_t
+hlog_total(void)
+{
+	struct msgbuf *buffer = msgbufp;
+	uint32_t total;
+
+	if (buffer == NULL || buffer->msg_magic != MSG_MAGIC) {
+		return 0;
+	}
+	bsd_log_lock_safe();
+	total = (uint32_t)buffer->msg_size;
+	bsd_log_unlock();
+	return total;
+}
