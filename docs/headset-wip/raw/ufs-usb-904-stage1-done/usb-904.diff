+/*
+ * Produce the log as a linear byte stream, the way log_dmesg() does it: start at the write
+ * pointer, walk the ring once, and keep only the bytes that are really there.
+ *
+ * Two things the first version got wrong. It started at msg_bufx and copied raw bytes, so the
+ * region past the newest character -- which is zeroes, not text -- came back as the answer.
+ * And it did not skip NULs, which is what the buffer holds in the parts that have never been
+ * written. Both are handled here: NUL is skipped and the walk wraps once.
+ *
+ * The result is cached in a per-read scratch, because a reader that asks for offset 0 wants the
+ * whole log and the host reads it in chunks; linearising it for every chunk would be quadratic.
+ */
+#define HLOG_LINEAR_MAX     (256u * 1024u)
+static char hlog_linear[HLOG_LINEAR_MAX];
+static uint32_t hlog_linear_len;
+static uint64_t hlog_linear_tick;
+
+static void
+hlog_linearize(void)
+{
+	struct msgbuf *buffer = msgbufp;
+	uint64_t now = mach_absolute_time();
+	uint32_t produced = 0;
+	uint32_t walked;
+
+	if (buffer == NULL || buffer->msg_magic != MSG_MAGIC || buffer->msg_bufc == NULL) {
+		hlog_linear_len = 0;
+		return;
+	}
+	/* rebuilding costs a walk of up to a quarter megabyte; once a second is plenty */
+	if (hlog_linear_len != 0 && now - hlog_linear_tick < 1000000000ull) {
+		return;
+	}
+
+	/*
+	 * Trial903: a plain-ASCII header, always first in the stream.
+	 *
+	 * If the host receives this line, the kernel side produced bytes and uiomove() carried them;
+	 * whatever follows then says what the message buffer itself looks like. With this in place
+	 * an empty answer can only mean the read never reached here at all, which is a different
+	 * problem from the buffer being empty.
+	 */
+	{
+		char header[160];
+		int written;
+
+		written = snprintf(header, sizeof(header),
+		    "HLOG magic=%#x size=%d bufx=%d bufr=%d bufc=%p dbg=%p..%p\n\n",
+		    buffer->msg_magic, buffer->msg_size, buffer->msg_bufx, buffer->msg_bufr,
+		    (void *)buffer->msg_bufc, (void *)debug_buf_base, (void *)debug_buf_ptr);
+		for (int i = 0; i < written && produced < HLOG_LINEAR_MAX - 1; i++) {
+			hlog_linear[produced++] = header[i];
+		}
+	}
+
+	bsd_log_lock_safe();
+	for (walked = 0; walked < (uint32_t)buffer->msg_size && produced < HLOG_LINEAR_MAX - 1;
+	    walked++) {
+		uint32_t index = (uint32_t)buffer->msg_bufx + walked;
+		char c;
+
+		if (index >= (uint32_t)buffer->msg_size) {
+			index -= (uint32_t)buffer->msg_size;
+		}
+		c = buffer->msg_bufc[index];
+		if (c == 0) {
+			continue;               /* never written, not part of the log */
+		}
+		hlog_linear[produced++] = c;
+	}
+	bsd_log_unlock();
+
+	hlog_linear[produced] = 0;
+	hlog_linear_len = produced;
+	hlog_linear_tick = now;
+
+
+
+}
+
+static int
+hlog_read_locked(char *destination, uint32_t want, uint32_t at)
+{
+	uint32_t available;
+
+	hlog_linearize();
+	if (at >= hlog_linear_len) {
+		return 0;
+	}
+	available = hlog_linear_len - at;
+	if (want > available) {
+		want = available;
+	}
+	memcpy(destination, hlog_linear + at, want);
+	return (int)want;
+}
+
+static int
+hlog_open(dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *process)
+{
+	(void)dev;
+	return 0;
+}
+
+static int
+hlog_close(__unused dev_t dev, __unused int flags, __unused int devtype,
+    __unused struct proc *process)
+{
+	return 0;
+}
+
+static int
+hlog_read(dev_t dev, struct uio *uio, __unused int flags)
+{
+	char chunk[1024];
+	uint32_t size;
+	int error = 0;
+
+	(void)dev;
+
+	/*
+	 * Trial903: serve the linearised length, not msg_size.
+	 *
+	 * The first version took hlog_total() -- which returns msg_size, a full megabyte -- as the
+	 * bound while hlog_read_locked() answers from the linearised copy, whose length is only what
+	 * the walk actually produced. With the bound larger than the data, the loop asked for
+	 * offsets past the end and got zero back each time, so a buffer holding thousands of lines
+	 * answered every read with nothing. That is the whole reason /dev/hlog came back empty
+	 * while the log on the flash was complete.
+	 */
+	hlog_linearize();
+	size = hlog_linear_len;
+	if (size == 0) {
+		return 0;
+	}
+
+	/*
+	 * Trial902f: one line saying what the buffer looks like, written through printf() so that
+	 * it lands in the same buffer being read -- if this line shows up in the answer, the walk
+	 * and the buffer agree about where the log is, and any remaining emptiness is elsewhere.
+	 */
+	{
+		static bool said;
+
+		if (!said) {
+			said = true;
+			printf("hlog: magic %#x size %d bufx %d bufr %d\n",
+			    msgbufp->msg_magic, msgbufp->msg_size,
+			    msgbufp->msg_bufx, msgbufp->msg_bufr);
+		}
+	}
+
+	while (uio_resid(uio) > 0) {
+		uint32_t at = (uint32_t)uio_offset(uio);
+		uint32_t want;
+		int got;
+
+		if (at >= size) {
+			break;                          /* nothing beyond the buffer */
+		}
+		want = MIN((uint32_t)sizeof(chunk), size - at);
+		want = MIN(want, (uint32_t)uio_resid(uio));
+
+		/*
+		 * Trial902f: no lock here. hlog_read_locked() -> hlog_linearize() takes the log's own
+		 * lock, and taking it twice on the same thread deadlocks -- which is what made every
+		 * read come back empty: the ioctl returned before the first byte was produced.
+		 */
+		got = hlog_read_locked(chunk, want, at);
+
+		if (got <= 0) {
+			break;
+		}
+		error = uiomove(chunk, got, uio);
+		if (error != 0) {
+			break;
+		}
+	}
+	return error;
+}
+
+static int
+hlog_write(__unused dev_t dev, __unused struct uio *uio, __unused int flags)
+{
+	return EPERM;                           /* the log belongs to printf() alone */
+}
+
+static const struct cdevsw hlog_cdevsw = {
+	.d_open = hlog_open, .d_close = hlog_close, .d_read = hlog_read, .d_write = hlog_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+/*
+ * /dev/hakios-return: any write ends the run. The value written is not looked at -- the fact of
+ * the write is the request -- which keeps the protocol on the other side to one line.
+ */
+static int
+hreturn_open(__unused dev_t dev, __unused int flags, __unused int devtype,
+    __unused struct proc *process)
+{
+	return 0;
+}
+
+static int
+hreturn_close(__unused dev_t dev, __unused int flags, __unused int devtype,
+    __unused struct proc *process)
+{
+	return 0;
+}
+
+static int
+hreturn_read(__unused dev_t dev, __unused struct uio *uio, __unused int flags)
+{
+	return EPERM;
+}
+
+static int
+hreturn_write(__unused dev_t dev, __unused struct uio *uio, __unused int flags)
+{
+	char command[64];
+	uint32_t take = MIN((uint32_t)uio_resid(uio), (uint32_t)sizeof(command) - 1);
+	int error;
+
+	if (take == 0) {
+		hakios_request_return("a bare write to /dev/hakios-return");
+		return 0;
+	}
+	error = uiomove(command, take, uio);
+	if (error != 0) {
+		return error;
+	}
+	command[take] = 0;
+	hakios_request_return(command);
+	return 0;
+}
+
+static const struct cdevsw hreturn_cdevsw = {
+	.d_open = hreturn_open, .d_close = hreturn_close, .d_read = hreturn_read,
+	.d_write = hreturn_write, .d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset,
+	.d_select = eno_select, .d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+void
+hakios_hlog_start(void)
+{
+	/*
+	 * Trial902b: cdevsw_add() only registers the switch table -- it does not make a node, which
+	 * is why the first run found neither device in /dev. devfs_make_node() is what puts the
+	 * entry there, the same pair hakios.audio.c uses.
+	 */
+	if (hlog_major < 0) {
+		hlog_major = cdevsw_add(-1, &hlog_cdevsw);
+		if (hlog_major < 0) {
+			printf("hlog: cdevsw_add failed\n");
+			return;
+		}
+		if (devfs_make_node(makedev(hlog_major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL,
+		    0444, HLOG_NAME) == NULL) {
+			printf("hlog: cannot make /dev/%s (major %d)\n", HLOG_NAME, hlog_major);
+			return;
+		}
+		printf("hlog: /dev/%s major %d, %u bytes of kernel log\n",
+		    HLOG_NAME, hlog_major, hlog_total());
+	}
+	if (hreturn_major < 0) {
+		hreturn_major = cdevsw_add(-1, &hreturn_cdevsw);
+		if (hreturn_major < 0) {
+			printf("hlog: cdevsw_add failed for the return knob\n");
+			return;
+		}
+		if (devfs_make_node(makedev(hreturn_major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL,
+		    0222, HRETURN_NAME) == NULL) {
+			printf("hlog: cannot make /dev/%s (major %d)\n", HRETURN_NAME, hreturn_major);
+			return;
+		}
+		printf("hlog: /dev/%s major %d\n", HRETURN_NAME, hreturn_major);
+	}
+}
+
+/*
+ * Ending the run early.
+ *
+ * loader_return() is the same path the run's time expiring takes: it stops the other processors,
+ * asks every driver to quiesce, linearises the log and hands it to the loader, and leaves the
+ * storage lease in the restored state. Calling anything else -- a reset, a jump -- would skip
+ * some of that and the loader would refuse to start Android the next time.
+ *
+ * It does not return, so the caller's answer to the host has to be sent before this is reached.
+ * hakid writes the reply first and sleeps briefly for the same reason.
+ */
+void
+hakios_request_return(const char *why)
+{
+	printf("hlog: return requested (%s); handing the phone back\n",
+	    (why != NULL && why[0] != 0) ? why : "no reason given");
+	loader_return();
+	for (;;) {
+		__asm__ volatile ("wfe");
+	}
+}
+
+
+/* ---- Trial804: the frames meet the network stack ---- */
+
+/*
+ * One ifnet on en0, backed by this endpoint. The contract in bsd/sys/hakios.net.h asks for
+ * three things: a transmit hook that copies the frame and returns at once, an input call for
+ * every frame that arrives, and a link-state call when the carrier changes.
+ *
+ * The USB thread is the only thing that touches the endpoint, so transmit() never talks to
+ * hardware -- it queues the copy and lets the thread send it. That keeps the "one thread owns
+ * the MMIO" rule the rest of this file follows.
+ */
+#define ECM_TX_QUEUE_DEPTH      8
+#define HAKIOS_ECM_UNIT         0
+#define HAKIOS_ECM_MAC0         0x02
+#define HAKIOS_ECM_MAC1         0x00
+#define HAKIOS_ECM_MAC2         0x00
+#define HAKIOS_ECM_MAC3         0x00
+#define HAKIOS_ECM_MAC4         0x68
+#define HAKIOS_ECM_MAC5         0x02
+
+static struct {
+	uint8_t data[ECM_TX_QUEUE_DEPTH][EP2_FRAME_MAX];
+	uint32_t len[ECM_TX_QUEUE_DEPTH];
+	unsigned head;
+	unsigned tail;
+	unsigned count;
+	lck_mtx_t lock;
+	bool up;
+} ecm_tx;
+static LCK_GRP_DECLARE(ecm_lck_grp, "hakios-usb-ecm");
+
+static bool ecm_attached;
+static bool ecm_loopback;        /* Trial802's echo, kept for testing without an ifnet */
+static uint32_t ecm_in_count;
+static uint32_t ecm_out_count;
+static bool ecm_link_up;
+
+static bool
+ecm_transmit(mbuf_t packet, size_t length)
+{
+	bool queued = false;
+
+	if (length < 14u || length > EP2_FRAME_MAX) {
+		return false;
+	}
+	lck_mtx_lock(&ecm_tx.lock);
+	if (ecm_tx.up && ecm_tx.count < ECM_TX_QUEUE_DEPTH) {
+		unsigned slot = ecm_tx.head;
+
+		if (mbuf_copydata(packet, 0, length, ecm_tx.data[slot]) == 0) {
+			ecm_tx.len[slot] = (uint32_t)length;
+			ecm_tx.head = (ecm_tx.head + 1u) % ECM_TX_QUEUE_DEPTH;
+			ecm_tx.count++;
+			queued = true;
+		}
+	}
+	lck_mtx_unlock(&ecm_tx.lock);
+	return queued;
+}
+
+/* Take the next frame the stack handed over. Called from the USB thread only. */
+static bool
+ecm_tx_pop(uint8_t *dst, uint32_t *length)
+{
+	bool got = false;
+
+	lck_mtx_lock(&ecm_tx.lock);
+	if (ecm_tx.count != 0u) {
+		unsigned slot = ecm_tx.tail;
+
+		for (uint32_t i = 0; i < ecm_tx.len[slot]; i++) {
+			dst[i] = ecm_tx.data[slot][i];
+		}
+		*length = ecm_tx.len[slot];
+		ecm_tx.tail = (ecm_tx.tail + 1u) % ECM_TX_QUEUE_DEPTH;
+		ecm_tx.count--;
+		got = true;
+	}
+	lck_mtx_unlock(&ecm_tx.lock);
+	return got;
+}
+
+static void
+ecm_set_link(bool up)
+{
+	if (ecm_link_up == up) {
+		return;
+	}
+	ecm_link_up = up;
+	lck_mtx_lock(&ecm_tx.lock);
+	ecm_tx.up = up && ecm_attached;
+	if (!up) {
+		ecm_tx.head = ecm_tx.tail = ecm_tx.count = 0;
+	}
+	lck_mtx_unlock(&ecm_tx.lock);
+
+	if (ecm_attached) {
+		hakios_net_link_state_unit(HAKIOS_ECM_UNIT, up);
+	}
+	printf("usb: ecm link %s\n", up ? "up" : "down");
+}
+
+static const struct hakios_net_link ecm_link = {
+	.name = "usb-ecm",
+	.unit = HAKIOS_ECM_UNIT,
+	.address = { HAKIOS_ECM_MAC0, HAKIOS_ECM_MAC1, HAKIOS_ECM_MAC2,
+	    HAKIOS_ECM_MAC3, HAKIOS_ECM_MAC4, HAKIOS_ECM_MAC5 },
+	.wireless = false,              /* a cable: the stack must not treat it as a radio */
+	.up = false,                    /* wait for the carrier, which arrives with alt 1 */
+	.transmit = ecm_transmit,
+	.poll = NULL,                   /* the USB thread polls; the stack needs no poll hook */
+};
+
+/*
+ * Attach once, on the first alt 1. Re-attaching on every enumeration would fail: the ifnet
+ * already exists and hakios_net_attach() says so rather than making a second one.
+ */
+static void
+ecm_attach(void)
+{
+	if (ecm_attached) {
+		lck_mtx_lock(&ecm_tx.lock);
+		ecm_tx.up = ecm_link_up;
+		lck_mtx_unlock(&ecm_tx.lock);
+		if (ecm_link_up) {
+			hakios_net_link_state_unit(HAKIOS_ECM_UNIT, true);
+		}
+		return;
+	}
+	if (!hakios_net_attach(&ecm_link)) {
+		printf("usb: ecm could not attach to en%u; the endpoint stays usable but the "
+		    "stack will not see it\n", HAKIOS_ECM_UNIT);
+		return;
+	}
+	ecm_attached = true;
+	lck_mtx_lock(&ecm_tx.lock);
+	ecm_tx.up = ecm_link_up;
+	lck_mtx_unlock(&ecm_tx.lock);
+	printf("usb: ecm attached to en%u, MAC 02:00:00:00:68:02\n", HAKIOS_ECM_UNIT);
+}
+
+
+/* ---- Trial802: the PIO data path ---- */
+
+/*
+ * Everything here runs on the USB thread and is the only thing that touches these registers.
+ * The host side of the test is a bulk loopback: whatever it writes to 0x02 comes back on 0x82.
+ */
+
+#define EP2_MPS         512u
+
+static void
+ep2_fifo_write(const uint8_t *src, uint32_t length)
+{
+	vm_offset_t fifo = usb_mac + U3D_FIFO2;
+	const uint8_t *in = src;
+
+	/* same split as EP0: the FIFO counts bytes per access, so the tail uses narrower writes */
+	while (length >= 4u) {
+		uint32_t value = (uint32_t)in[0] | ((uint32_t)in[1] << 8) |
+		    ((uint32_t)in[2] << 16) | ((uint32_t)in[3] << 24);
+
+		*(volatile uint32_t *)fifo = value;
+		in += 4;
+		length -= 4;
+	}
+	if ((length & 2u) != 0u) {
+		*(volatile uint16_t *)fifo = (uint16_t)in[0] | ((uint16_t)in[1] << 8);
+		in += 2;
+	}
+	if ((length & 1u) != 0u) {
+		*(volatile uint8_t *)fifo = in[0];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+ep2_fifo_read(uint8_t *dst, uint32_t length)
+{
+	vm_offset_t fifo = usb_mac + U3D_FIFO2;
+	uint8_t *out = dst;
+
+	/*
+	 * The plan's rule: read whole words while they are there, and for a tail of one to three
+	 * bytes read one more word and keep only the bytes wanted. Reading a byte at a time would
+	 * desynchronise the FIFO.
+	 */
+	while (length >= 4u) {
+		uint32_t value = *(volatile uint32_t *)fifo;
+
+		out[0] = (uint8_t)(value & 0xff);
+		out[1] = (uint8_t)((value >> 8) & 0xff);
+		out[2] = (uint8_t)((value >> 16) & 0xff);
+		out[3] = (uint8_t)((value >> 24) & 0xff);
+		out += 4;
+		length -= 4;
+	}
+	if (length != 0u) {
+		uint32_t value = *(volatile uint32_t *)fifo;
+
+		for (uint32_t i = 0; i < length; i++) {
+			out[i] = (uint8_t)((value >> (8 * i)) & 0xff);
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * Take every packet the endpoint has ready. A packet shorter than the maximum packet size ends
+ * the frame; an exact multiple is ended by a zero-length packet, which is why the host sends one.
+ */
+static void
+ep2_out_service(void)
+{
+	for (unsigned round = 0; round < 8u; round++) {
+		uint32_t csr = mac_rd(U3D_RX2CSR0);
+		uint32_t count;
+		uint32_t take;
+
+		if ((csr & EP_RXPKTRDY) == 0u) {
+			break;
+		}
+		count = (mac_rd(U3D_RX2CSR3) >> 16) & 0xffffu;
+
+		if (count > EP2_MPS) {
+			printf("usb: ep2 out bad count %u csr %#x; resetting the endpoint\n", count, csr);
+			ep2_reset_pulse();
+			mac_wr(U3D_EPISR, EP2_ISR_BOTH);
+			mac_wr(U3D_EPIESR, EP2_ISR_BOTH);
+			ep2_rx_len = 0;
+			ep2_rx_overflow = false;
+			break;
+		}
+
+		take = count;
+		if (ep2_rx_len + take > EP2_FRAME_MAX) {
+			if (!ep2_rx_overflow) {
+				printf("usb: ep2 out frame over %u bytes; dropping\n", EP2_FRAME_MAX);
+			}
+			ep2_rx_overflow = true;
+			take = 0;
+		} else if (take != 0u) {
+			ep2_fifo_read(ep2_rx_frame + ep2_rx_len, take);
+			ep2_rx_len += take;
+		}
+		ep2_rx_packets++;
+
+		/* release the packet: acknowledge the FIFO and let the next slot open */
+		mac_wr(U3D_RX2CSR0, (csr & EP_RX_CSR_KEEP) | EP_RXPKTRDY);
+		mac_wr(U3D_EPISR, EP_ISR_RX(2));
+
+		if (count < EP2_MPS) {
+			if (ep2_rx_overflow) {
+				ep2_rx_overflow = false;
+			} else if (ep2_rx_len != 0u) {
+				/*
+				 * Trial804: a whole frame -- hand it to the network stack, which copies it.
+				 * The loopback that Trial802 used lives on behind the ecm_loopback switch so
+				 * the data path can still be checked without an ifnet in the way.
+				 */
+				if (ecm_loopback) {
+					if (ep2_rx_len <= sizeof(ep2_tx_frame) && !ep2_tx_active) {
+						for (uint32_t i = 0; i < ep2_rx_len; i++) {
+							ep2_tx_frame[i] = ep2_rx_frame[i];
+						}
+						ep2_tx_len = ep2_rx_len;
+						ep2_tx_off = 0;
+						ep2_tx_active = true;
+						ep2_tx_zlp = (ep2_rx_len % EP2_MPS) == 0u;
+					}
+				} else if (ep2_rx_len >= 14u && ecm_link_up) {
+					hakios_net_input_unit(HAKIOS_ECM_UNIT, ep2_rx_frame, ep2_rx_len);
+					ecm_in_count++;
+				}
+			}
+			ep2_rx_len = 0;
+		}
+	}
+}
+
+/* Send at most one packet per call, so EP0 keeps getting served while a frame is in flight. */
+static void
+ep2_in_service(void)
+{
+	uint32_t csr;
+	uint32_t chunk;
+	uint32_t epi;
+
+	if (!ep2_tx_active && !ecm_loopback && ecm_link_up) {
+		/*
+		 * Trial804: nothing in flight, so ask the stack whether it has a frame. The copy is
+		 * taken under the queue lock and the lock is dropped before any register is touched.
+		 */
+		uint32_t queued = 0;
+
+		if (ecm_tx_pop(ep2_tx_frame, &queued)) {
+			ep2_tx_len = queued;
+			ep2_tx_off = 0;
+			ep2_tx_active = true;
+			ep2_tx_zlp = (queued % EP2_MPS) == 0u;
+		}
+	}
+	if (!ep2_tx_active) {
+		return;
+	}
+	csr = mac_rd(U3D_TX2CSR0);
+	if ((csr & (EP_TXPKTRDY | EP_TX_FIFOFULL)) != 0u) {
+		return;         /* the previous packet has not gone yet */
+	}
+
+	/*
+	 * Trial802b: one state machine, two kinds of packet.
+	 *
+	 * The 512-byte case stalled because the zero-length packet that ends an exact-multiple
+	 * frame was never submitted: the old code cleared the "owe a ZLP" flag as soon as the
+	 * last data packet went out, and the next call then saw nothing left to send and an
+	 * empty flag, and finished the transfer. The host, still waiting for the packet that
+	 * marks the end of the frame, timed out.
+	 *
+	 * Now the flag means "a zero-length packet is still owed", and it is only cleared when
+	 * that packet has actually been submitted.
+	 */
+	chunk = ep2_tx_len - ep2_tx_off;
+	if (chunk > EP2_MPS) {
+		chunk = EP2_MPS;
+	}
+
+	if (chunk != 0u) {
+		ep2_fifo_write(ep2_tx_frame + ep2_tx_off, chunk);
+	} else if (ep2_tx_zlp) {
+		ep2_tx_zlp = false;             /* this submission is the zero-length packet */
+		ep2_zlp_count++;
+	} else {
+		ep2_tx_active = false;          /* everything, including any ZLP, has gone */
+		return;
+	}
+
+	/* drop a stale completion before submitting, the same way the EP0 path does */
+	epi = mac_rd(U3D_EPISR);
+	if ((epi & EP_ISR_TX(2)) != 0u) {
+		mac_wr(U3D_EPISR, EP_ISR_TX(2));
+	}
+	mac_wr(U3D_TX2CSR0, (csr & EP_TX_CSR_KEEP) | EP_TXPKTRDY);
+
+	ep2_tx_off += chunk;
+	ep2_tx_packets++;
+
+	/*
+	 * The transfer ends here only when the last data packet has gone and no zero-length
+	 * packet is owed; otherwise it stays active so the next call can finish the job.
+	 */
+	if (chunk != 0u && ep2_tx_off >= ep2_tx_len && !ep2_tx_zlp) {
+		ep2_tx_active = false;
+	}
+}
+
+/* ---- Trial803: EP1, the notification endpoint ---- */
+
+/*
+ * EP1 IN carries NETWORK_CONNECTION and CONNECTION_SPEED_CHANGE. The plan puts its FIFO at the
+ * bottom of the TX RAM, 16 bytes, with bInterval 8 (16 ms at high speed) -- the hardware field
+ * takes bInterval - 1.
+ */
+#define EP1_MPS         16u
+#define EP1_NOTIFY_MAX  16u
+
+static bool ep1_ready;
+static uint8_t ep1_msg[EP1_NOTIFY_MAX];
+static uint32_t ep1_len;
+static bool ep1_pending;
+
+static void
+ep1_disable(void)
+{
+	if (!ep1_ready) {
+		return;
+	}
+	ep1_ready = false;
+	ep1_pending = false;
+	ep1_len = 0;
+
+	mac_wr(U3D_EPIECR, EP_ISR_TX(1));
+	mac_wr(U3D_TX1CSR0, 0u);
+	mac_wr(U3D_TX1CSR1, 0u);
+	mac_wr(U3D_TX1CSR2, 0u);
+	mac_set(U3D_EP_RST, EP_RST_IN(1));
+	delay(1);
+	mac_clear(U3D_EP_RST, EP_RST_IN(1));
+	mac_wr(U3D_EPISR, EP_ISR_TX(1));
+}
+
+static bool
+ep1_enable(void)
+{
+	if (ep1_ready) {
+		return true;
+	}
+	mac_wr(U3D_EPIECR, EP_ISR_TX(1));
+	mac_wr(U3D_EPISR, EP_ISR_TX(1));
+	mac_set(U3D_EP_RST, EP_RST_IN(1));
+	delay(1);
+	mac_clear(U3D_EP_RST, EP_RST_IN(1));
+
+	/* FIFO at 0x000 in the TX RAM, 16 bytes; bInterval 8 means the field gets 7 */
+	mac_wr(U3D_TX1CSR2, EP_CSR2_BINTERVAL(7u) | EP_CSR2_FIFOSEG(4u) |
+	    EP_CSR2_FIFOADDR(0x000u));
+	mac_wr(U3D_TX1CSR1, 0u);
+	mac_wr(U3D_TX1CSR0, EP_CSR_MAXPKT(EP1_MPS));
+
+	mac_wr(U3D_EPIESR, EP_ISR_TX(1));
+	mac_wr(U3D_EPISR, EP_ISR_TX(1));
+
+	ep1_ready = true;
+	printf("usb: ep1 enabled; tx1 %#x/%#x/%#x epier %#x\n",
+	    mac_rd(U3D_TX1CSR0), mac_rd(U3D_TX1CSR1), mac_rd(U3D_TX1CSR2),
+	    mac_rd(U3D_EPIER) & EP_ISR_TX(1));
+	return true;
+}
+
+/* Queue one notification. The message stays until the hardware has taken it. */
+static void
+ep1_notify(const uint8_t *data, uint32_t length)
+{
+	if (!ep1_ready || length > EP1_MPS) {
+		return;
+	}
+	for (uint32_t i = 0; i < length; i++) {
+		ep1_msg[i] = data[i];
+	}
+	ep1_len = length;
+	ep1_pending = true;
+}
+
+static void
+ep1_service(void)
+{
+	uint32_t csr;
+	uint32_t epi;
+
+	if (!ep1_ready) {
+		return;
+	}
+
+	/*
+	 * Trial804b: acknowledge EP1's completion whether or not a message is waiting.
+	 *
+	 * The log shows EPISR bit 1 standing from 20.5 s to the end of the run and never being
+	 * written back, because the acknowledge lived after the "is anything pending" test and
+	 * only one notification was ever queued. A completion nobody clears is exactly the state
+	 * that kept EP0 from working in Trial799.
+	 */
+	epi = mac_rd(U3D_EPISR);
+	if ((epi & EP_ISR_TX(1)) != 0u) {
+		mac_wr(U3D_EPISR, EP_ISR_TX(1));
+	}
+
+	if (!ep1_pending) {
+		return;
+	}
+	csr = mac_rd(U3D_TX1CSR0);
+	if ((csr & EP_TXPKTRDY) != 0u) {
+		return;         /* the previous notification has not gone yet */
+	}
+
+	/* the standard CDC notifications: 8-byte header with the bitmap or the two rates */
+	{
+		vm_offset_t fifo = usb_mac + U3D_FIFO1;
+
+		for (uint32_t i = 0; i < ep1_len; i += 4u) {
+			uint32_t word = 0;
+
+			for (uint32_t b = 0; b < 4u && i + b < ep1_len; b++) {
+				word |= (uint32_t)ep1_msg[i + b] << (8 * b);
+			}
+			*(volatile uint32_t *)fifo = word;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	mac_wr(U3D_EPISR, EP_ISR_TX(1));
+	mac_wr(U3D_TX1CSR0, (csr & EP_TX_CSR_KEEP) | EP_TXPKTRDY);
+	ep1_pending = false;
+}
+
+/* NETWORK_CONNECTION: a1 00 <connected> 00 00 00 00 00 */
+static void
+ep1_report_link(bool up)
+{
+	uint8_t msg[8] = { 0xa1, 0x00, up ? 0x01 : 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 };
+
+	ep1_notify(msg, sizeof(msg));
+}
+
+/* CONNECTION_SPEED_CHANGE: a1 2a 00 00 00 00 08 00, then two little-endian rates */
+static void
+ep1_report_speed(uint32_t down, uint32_t up)
+{
+	uint8_t msg[16] = {
+		0xa1, 0x2a, 0x00, 0x00, 0x00, 0x00, 0x08, 0x00,
+		(uint8_t)(down & 0xff), (uint8_t)((down >> 8) & 0xff),
+		(uint8_t)((down >> 16) & 0xff), (uint8_t)((down >> 24) & 0xff),
+		(uint8_t)(up & 0xff), (uint8_t)((up >> 8) & 0xff),
+		(uint8_t)((up >> 16) & 0xff), (uint8_t)((up >> 24) & 0xff),
+	};
+
+	ep1_notify(msg, sizeof(msg));
+}
+
+static void
+ep2_service(void)
+{
+	/*
+	 * Trial803: the notification endpoint is served here too. EP1 is independent of whether
+	 * the data path is up -- the plan has it reporting link down while alt 0 is selected --
+	 * so it is serviced regardless of ep2_ready.
+	 */
+	ep1_service();
+
+	if (!ep2_ready) {
+		return;
+	}
+	ep2_out_service();
+	ep2_in_service();
+}
+
+static bool
+ep2_enable(void)
+{
+	uint32_t tx0, rx0, tx1, rx1, tx2, rx2;
+
+	if (ep2_qmu_left_active()) {
+		printf("usb: ep2 enable refused, a QMU queue is still active "
+		    "(txqcsr2 %#x rxqcsr2 %#x)\n",
+		    mac_rd(U3D_TXQCSR2), mac_rd(U3D_RXQCSR2));
+		return false;
+	}
+
+	/* Start from a known state: no events, endpoint held in reset, then released. */
+	mac_wr(U3D_EPIECR, EP2_ISR_BOTH);
+	mac_wr(U3D_EPISR, EP2_ISR_BOTH);
+	ep2_reset_pulse();
+
+	/*
+	 * CSR0: max packet 512, and DMAREQEN (bit 29) left clear so the endpoint works from the
+	 * CPU through the FIFO. CSR1: type 0 is bulk, slot 0. CSR2: segsize 9 is 512 bytes, and the
+	 * FIFO address is a byte address shifted right four bits.
+	 */
+	mac_wr(U3D_TX2CSR2, EP_CSR2_FIFOSEG(EP_FIFO_SEGSIZE) | EP_CSR2_FIFOADDR(EP2_TX_FIFO_ADDR));
+	mac_wr(U3D_TX2CSR1, 0u);
+	mac_wr(U3D_TX2CSR0, EP_CSR_MAXPKT(USB_EP0_MAXPACKET_HS * 8u));   /* 512 */
+
+	mac_wr(U3D_RX2CSR2, EP_CSR2_FIFOSEG(EP_FIFO_SEGSIZE) | EP_CSR2_FIFOADDR(EP2_RX_FIFO_ADDR));
+	mac_wr(U3D_RX2CSR1, 0u);
+	mac_wr(U3D_RX2CSR0, EP_CSR_MAXPKT(USB_EP0_MAXPACKET_HS * 8u));
+
+	/* the vendor's USB2 L1 exit and OUT flow-control checks for this endpoint */
+	mac_set(U3D_USB2_L1_CTRL, U3D_USB2_L1_EP2_BITS);
+	mac_set(U3D_OUT_FLOW_CTRL, U3D_OUT_FLOW_EP2_BITS);
+
+	/* enable the endpoint's own events, then verify what the hardware took */
+	mac_wr(U3D_EPIESR, EP2_ISR_BOTH);
+	mac_wr(U3D_EPISR, EP2_ISR_BOTH);
+
+	tx0 = mac_rd(U3D_TX2CSR0); rx0 = mac_rd(U3D_RX2CSR0);
+	tx1 = mac_rd(U3D_TX2CSR1); rx1 = mac_rd(U3D_RX2CSR1);
+	tx2 = mac_rd(U3D_TX2CSR2); rx2 = mac_rd(U3D_RX2CSR2);
+
+	ep2_ready = true;
+
+	/* Trial804: the stack gets its interface on the first alt 1, then the carrier comes up */
+	ecm_attach();
+	ecm_set_link(true);
+
+	/* Trial803: the host learns the link is up from EP1, not from the bulk endpoints */
+	ep1_report_link(true);
+	ep1_report_speed(480000000u, 480000000u);
+
+	printf("usb: ep2 enabled; "
+	    "tx2 %#x/%#x/%#x rx2 %#x/%#x/%#x epier %#x ep_rst %#x\n",
+	    tx0, tx1, tx2, rx0, rx1, rx2,
+	    mac_rd(U3D_EPIER) & EP2_ISR_BOTH, mac_rd(U3D_EP_RST) & EP2_RST_BOTH);
+
+	/* the fields the plan asks to confirm, not the volatile status bits */
+	printf("usb: ep2 fields; maxpkt tx %u rx %u, type tx %u rx %u, segsize tx %u rx %u, "
+	    "dmareq tx %u rx %u, reset released %u\n",
+	    tx0 & EP_CSR_MAXPKT_MSK, rx0 & EP_CSR_MAXPKT_MSK,
+	    (tx1 & EP_CSR1_TYPE_MSK) >> 4, (rx1 & EP_CSR1_TYPE_MSK) >> 4,
+	    (tx2 & 0xfu << 16) >> 16, (rx2 & 0xfu << 16) >> 16,
+	    (tx0 >> 29) & 1u, (rx0 >> 29) & 1u,
+	    (mac_rd(U3D_EP_RST) & EP2_RST_BOTH) == 0u);
+
+	return true;
+}
