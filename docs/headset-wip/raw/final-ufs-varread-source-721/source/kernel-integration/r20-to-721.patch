+#define VR_REF_CRC_LBA1   UINT32_C(0x28a2836c)
+#define VR_REF_CRC_LBA2   UINT32_C(0x0d024e0c)
+#define VR_REF_CRC_LBA15  UINT32_C(0xc71c0011)
