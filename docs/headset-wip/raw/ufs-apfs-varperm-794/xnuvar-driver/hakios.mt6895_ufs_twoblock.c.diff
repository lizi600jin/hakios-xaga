+/*
+ * Trial795: the blocks this driver is allowed to touch, as two disjoint ranges.
+ *
+ * Trial760 defined the writable zone as the part of xnusys that nobody claims: after the APFS
+ * container's last block and before the loader's tail. That is still true of xnusys, and the
+ * numbers below are unchanged -- but the 64 GiB volume does not live in xnusys. It is GPT entry
+ * 89, running from logical block 13803264 to 30580479, which is a different partition entirely.
+ *
+ * Two ranges, tested separately. Concatenating them into one min/max span would admit every block
+ * of userdata between 653559 and 13803264 -- 5.1 GiB of another file system -- and that is the one
+ * mistake this guard exists to stop.
+ */
+#define XNUVAR_FIRST_BLOCK  UINT64_C(13803264)
+#define XNUVAR_LAST_BLOCK   UINT64_C(30580479)
+
+static inline bool
+twoblock_block_is_ours(uint64_t block)
+{
+	if (block >= UINT64_C(608448) && block <= UINT64_C(653559)) return true;
+	if (block >= XNUVAR_FIRST_BLOCK && block <= XNUVAR_LAST_BLOCK) return true;
+	return false;
+}
