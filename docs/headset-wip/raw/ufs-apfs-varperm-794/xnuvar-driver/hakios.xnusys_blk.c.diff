+ */
+static int
+xnuvar_open(dev_t dev, int flag, int devtype, struct proc *p)
+{
+	(void)dev; (void)flag; (void)devtype; (void)p;
+	printf("xnuvar: open flag=%d\n", flag);
+	return xnusys_ready ? 0 : ENXIO;
+}
+
+static int
+xnuvar_close(dev_t dev, int flag, int devtype, struct proc *p)
+{
+	(void)dev; (void)flag; (void)devtype; (void)p;
+	return 0;
+}
