+	return (int)XNUSYS_SECTOR;
+}
+
+static int
+xnuvar_read(dev_t dev, struct uio *uio, __unused int flags)
+{
+	return physio(xnuvar_strategy, NULL, dev, B_READ,
+	    (u_int (*)(buf_t))xnuvar_size, uio, XNUSYS_SECTOR);
+}
+
+static int
+xnuvar_write(dev_t dev, struct uio *uio, __unused int flags)
+{
+	return physio(xnuvar_strategy, NULL, dev, B_WRITE,
+	    (u_int (*)(buf_t))xnuvar_size, uio, XNUSYS_SECTOR);
+}
+
+static int
+xnuvar_ioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+	case DKIOCSETBLOCKSIZE:
+		*(uint32_t *)data = XNUSYS_SECTOR;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		/*
+		 * 16777216 blocks of 4096, expressed in 512-byte sectors: 134217728. Both halves are
+		 * 64-bit here; a 32-bit multiply of the block count would wrap and the file system
+		 * would size itself against a number that has nothing to do with the partition.
+		 */
+		*(uint64_t *)data = XNUVAR_PART_BYTES / XNUSYS_SECTOR;
+		return 0;
+	case DKIOCISWRITABLE:
+		*(uint32_t *)data = 1;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*(uint64_t *)data = 1;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*(uint64_t *)data = 1;
+		return 0;
+	case DKIOCGETMAXBYTECOUNTREAD:
+	case DKIOCGETMAXBYTECOUNTWRITE:
+		*(uint64_t *)data = XNUSYS_BLOCK;
+		return 0;
+	case DKIOCSYNCHRONIZE:
+	case DKIOCSYNCHRONIZECACHE: {
+		int err = 0;
+		if (xnusys_lock == NULL) return ENXIO;
+		lck_mtx_lock(xnusys_lock);
+		if (!hakios_mt6895_ufs_zone_flush()) err = EIO;
+		lck_mtx_unlock(xnusys_lock);
+		return err;
+	}
+	default:
+		return eno_ioctl(dev, cmd, data, flag, p);
+	}
+}
